        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 secretion rate by PDAC cancer cells</body>
        </notes>
      </parameter>
      <parameter id="mwbd12027e_4f4e_4e2f_bf6b_0cef1e225372" name="k_IL6_sec_TAM" value="1e-11" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 secretion rate by TAMs (M1+M2 pooled)</body>
        </notes>
      </parameter>
      <parameter id="mw049cc508_9d44_41e9_9251_07d5ea33c79c" name="k_IL6_deg" value="16" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mwf50828f0_151d_4483_8994_9bc3a63130a2" name="IL6_50_MDSC" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 enhancement of MDSC recruitment</body>
        </notes>
      </parameter>
      <parameter id="mw8f0dbbd2_b49a_4b6d_b4f3_13dbe9af0496" name="IL6_50_M2" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 promotion of M2 polarization</body>
