      <parameter id="mw214f34a2_3e0f_4ce9_a9a9_8949e524a38b" name="vol_Mcell" value="4849.04826081585" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of a single macrophage cell </body>
        </notes>
      </parameter>
      <parameter id="mwd2f8563a_cb54_412d_869a_2c084c6f6fb6" name="kon_CD47_SIRPa" value="0.0625" units="MWDERIVEDUNIT_1__micromolarity_minute_nanometer" constant="true">
