      <parameter id="mwddfbe164_3b8d_48c6_a16b_3f4517d83da9" name="IL6_50_M2" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 promotion of M2 polarization</body>
