      <parameter id="mw4294f085_63ff_4d37_ad73_d23090aa4670" name="k_IL1_sec" value="1e-12" units="MWDERIVEDUNIT_nanomole__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-1alpha secretion rate by cancer cells</body>
