        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max Th-&gt;Treg conversion rate via apCAF</body>
        </notes>
      </parameter>
      <parameter id="mw3d877757_a584_4116_be26_958d4f4d403e" name="K_apCAF_Treg" value="100000000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max apCAF count for Treg induction saturation</body>
        </notes>
      </parameter>
      <parameter id="mw466c01d6_f378_4011_ac69_7f8248976aea" name="P1_50_apCAF" value="1e-09" units="MWBUILTINUNIT_molarity" constant="true">
        <notes>
