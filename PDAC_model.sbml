                </apply>
                <apply>
                  <plus/>
                  <ci> mw51f12fda_49fc_4766_a490_d0c9f2b013e5 </ci>
                  <ci> mw612d8498_2577_460c_8fe9_128a54d184d2 </ci>
                  <ci> mw7be726ff_903f_419d_b73d_8ed077f6519e </ci>
                </apply>
