      <species id="mw517d50fb_0bf3_4bf9_85b9_db0d1badd991" name="IL12" compartment="mwd4c54e3d_3810_4f3b_931e_90c5a580780e" initialConcentration="0" substanceUnits="MWDERIVEDUNIT_nanomolarity_milliliter" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false">
