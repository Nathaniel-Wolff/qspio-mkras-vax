        </notes>
      </parameter>
      <parameter id="mw1797e9fd_6f73_4f17_b451_c3b33af862c6" name="H_PD1_M" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for PD1-mediated inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mwcfe88e86_7646_4f01_a4a2_f3da53cd0a6e" name="H_SIRPa" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for SIRPa-mediated inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mwd47b94ee_dc94_4a37_ba47_6b2c8438e7f3" name="C_CD47" value="400" units="MWDERIVEDUNIT_molecule__micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CD47 expression on cancer cells </body>
        </notes>
      </parameter>
      <parameter id="mwb36e6721_a8e5_41ac_802b_de2852f3fbb0" name="M_PD1_total" value="12500" units="MWBUILTINUNIT_molecule" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">PD-1 expression on macrophages </body>
        </notes>
      </parameter>
      <parameter id="mw3beef966_76ca_4e4d_83e2_b7a427e3432d" name="M_SIRPa" value="100" units="MWDERIVEDUNIT_molecule__micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">SIRPa expression on macrophages </body>
        </notes>
      </parameter>
      <parameter id="mw2eae168a_d271_4c99_b203_60a9702d19c0" name="A_Mcell" value="1385.4423602331" units="MWDERIVEDUNIT_micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Surface area of the macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw81069670_6c3d_47a0_bac3_b387807de271" name="IL10_50_phago" value="270" units="MWBUILTINPREFIX_pico_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal IL-10 level for phagocytosis by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw6d1915d5_160d_4dde_b187_b476da90a95e" name="K_M1_phago" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Association coefficient for macrophage and cancer cell </body>
        </notes>
      </parameter>
      <parameter id="mwfcf7a6f0_075a_452f_b2fc_89c2b5206ebc" name="M_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of macrophages </body>
        </notes>
      </parameter>
      <parameter id="mw754c4bf7_6426_411b_991f_799d0e613ba7" name="H_IL10_APC" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill: IL-10 suppression of DC maturation (cDC1/cDC2)</body>
        </notes>
      </parameter>
      <parameter id="mw3e3036cd_674e_426d_af8f_ba441e9cdae9" name="H_IL10_Treg" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill: IL-10 amplification of Treg-mediated CD8 exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwcd3f4112_6b80_4f75_a827_91b8e3c066a8" name="H_IL10_phago" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL10-mediated inhibition on phagocytosis </body>
        </notes>
      </parameter>
      <parameter id="mw6bd1d69d_c630_4a3e_97cd_70520404aed9" name="H_IL12" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL12 </body>
        </notes>
      </parameter>
      <parameter id="mwd9d827e9_3ae1_4d0f_ada2_4ac01eff4438" name="H_IL6_M2" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL-6 promotion of M2 macrophage polarization</body>
        </notes>
      </parameter>
      <parameter id="mwcf8fd5b0_a590_4462_835e_deadb951862c" name="phi_M2_skew" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Averaged M2-polarizing milieu drive (TGFb/IL-10/IL-6); sets both the fraction of recruited monocytes differentiating directly to M2 and the M1-&gt;M2 polarization drive</body>
        </notes>
      </parameter>
      <parameter id="mw8eb6965f_9207_4682_a16e_56428df68e5f" name="k_CAF_encounter" value="1000000" units="MWDERIVEDUNIT_cell__milliliter_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of encountering resident PSCs as tumor expands into pancreas</body>
        </notes>
      </parameter>
      <parameter id="mwa92defa7_d489_4cae_809a_cea944c70734" name="k_CAF_const" value="2000000" units="MWDERIVEDUNIT_cell__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Constitutive PSC density in pancreatic tissue</body>
        </notes>
      </parameter>
      <parameter id="mw7ffe926a_5604_4588_bd0e_bfc73b44d4c8" name="k_PSC_to_myCAF" value="0.2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;myCAF activation rate (TGFb-driven)</body>
        </notes>
      </parameter>
      <parameter id="mwf05b6581_acd0_43e6_b7c3_7878d9cf1215" name="k_PSC_to_iCAF" value="0.2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;iCAF activation rate (IL-1-driven)</body>
        </notes>
      </parameter>
      <parameter id="mwe4764d0c_56a7_4ab6_9b53_8f0dbc6806fa" name="k_PSC_to_apCAF" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;apCAF activation rate (constitutive low)</body>
        </notes>
      </parameter>
      <parameter id="mw01455c6f_d848_4687_a1ef_8498cc6b1e12" name="k_iCAF_to_myCAF" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF-&gt;myCAF interconversion (TGFb-driven)</body>
        </notes>
      </parameter>
      <parameter id="mw6a31fd9e_a18b_45e0_86ea_70970663d265" name="k_myCAF_to_iCAF" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">myCAF-&gt;iCAF interconversion (IL-1-driven)</body>
        </notes>
      </parameter>
      <parameter id="mwef8573b0_2185_4725_8553_a5aa6e1fa3f7" name="k_myCAF_prolif" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">myCAF proliferation rate</body>
        </notes>
      </parameter>
      <parameter id="mw6496bc9f_49ad_4b3a_ae91_7b883b7e4811" name="k_iCAF_prolif" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF proliferation rate</body>
        </notes>
      </parameter>
      <parameter id="mw476fd060_2c79_49cf_aeb9_e4a5184a00b2" name="k_apCAF_prolif" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">apCAF proliferation rate (lower than iCAF/myCAF)</body>
        </notes>
      </parameter>
      <parameter id="mw74ae00ae_daf3_444d_a06e_7d0ec3633391" name="f_stroma_max" value="2.43" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF:cancer ratio — total carrying-capacity budget partitioned across iCAF/myCAF/apCAF</body>
        </notes>
      </parameter>
      <parameter id="mw4d9567dd_05e4_447c_97b7_39ed216ba0f6" name="f_apCAF_of_total" value="0.1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">apCAF share of the total CAF carrying capacity. Default 0.1 from Elyada 2019 Fig 5D (apCAFs ~10% of PDAC CAFs). Free parameter in the stick-breaking simplex parameterization (paired with f_iCAF_of_non_apCAF).</body>
        </notes>
      </parameter>
      <parameter id="mw82965f14_1d2d_4533_8f8f_d4a222694893" name="f_iCAF_of_non_apCAF" value="0.222" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF share of the non-apCAF CAF mass (stick-breaking second step). Default 0.222 from Elyada 2019 Fig 5D — myCAF 0.7 + iCAF 0.2 of total → iCAF/(iCAF+myCAF) = 0.2/0.9 = 0.222. Free parameter in the stick-breaking simplex parameterization (paired with f_apCAF_of_total).</body>
        </notes>
      </parameter>
      <parameter id="mw0331d8d5_dd57_4fc3_8487_61f35469a083" name="k_col_myCAF_sec" value="5e-08" units="MWDERIVEDUNIT_milligram__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw9f3e87fc_3104_4db2_b84d_f813d7ba4cfb" name="f_col_basal" value="0.15" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Basal fraction of collagen secretion (TGFb-independent)</body>
        </notes>
      </parameter>
      <parameter id="mw754e149c_5a39_4d02_b441_24007acdeabb" name="TGFb_50_CAF_act" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for CAF activation and interconversion</body>
        </notes>
      </parameter>
      <parameter id="mwb36da8c1_54de_4852_bc15_77e3f91a2e8f" name="TGFb_50_col_sec" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for collagen secretion</body>
        </notes>
      </parameter>
      <parameter id="mwb3729ccc_a9a6_4e08_a597_24114b79f462" name="k_col_deg" value="0.007" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Constitutive collagen degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw52a158ba_5c55_43a7_996c_8ccb5105ab54" name="k_MMP_M2" value="1e-08" units="MWDERIVEDUNIT_milliliter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">M2 macrophage MMP-mediated collagen degradation</body>
        </notes>
      </parameter>
      <parameter id="mwe0e87699_297c_4e95_a125_c929557ed7ff" name="phi_cross_50" value="0.03" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction at 50% MMP-susceptibility (LOX-crosslinking shield)</body>
        </notes>
      </parameter>
      <parameter id="mw4159e188_459c_4017_be87_32433115a5de" name="f_nascent" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Fraction of collagen susceptible to M2 MMP degradation (non-crosslinked)</body>
        </notes>
      </parameter>
      <parameter id="mwe9f3fd6a_368c_4576_92a9_2728be466a77" name="rho_collagen" value="0.103" units="MWDERIVEDUNIT_gram__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen packing density (material constant)</body>
        </notes>
      </parameter>
      <parameter id="mw9049ef98_9c3b_4dcf_8caa_fe1bca43c14f" name="phi_collagen" value="0.12" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction (0-1). Bare-volume normalized; primary input for all ECM Hill functions.</body>
        </notes>
      </parameter>
      <parameter id="mw79c506b7_b631_4ada_852b_400c26a8cf03" name="k_qpsc_death" value="0.005" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of quiescent PSCs</body>
        </notes>
      </parameter>
      <parameter id="mwa29f55d9_78dd_4455_ac74_3822196b6ff7" name="k_iCAF_death" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw30d4f31f_f213_4298_a25b_676d252f0526" name="k_myCAF_death" value="0.015" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw8762a811_ac58_46cb_a1c5_591b75eacecb" name="k_apCAF_death" value="0.03" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw325067f9_01a5_414d_a8f5_f3d1ad2ddc11" name="d_pore_ref" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference pore size in normal pancreas (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mwadad9c64_a1c7_44dc_bdcf_94525c19ce9f" name="phi_col_ref" value="0.046" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction in normal pancreas (reference)</body>
        </notes>
      </parameter>
      <parameter id="mwbc7abf35_1b86_4a4d_84c5_016a4412e61d" name="d_crit_T" value="2.3" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for T cell migration arrest (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mwe9d5f519_7fb5_4c38_a4e4_51602234708c" name="d_crit_APC" value="2.1" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for APC migration arrest (podosome/MMP migration)</body>
        </notes>
      </parameter>
      <parameter id="mw7ea47b88_dcc4_4ff2_aa64_644ff4438e08" name="n_pore" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for pore-size exclusion sharpness</body>
        </notes>
      </parameter>
      <parameter id="mw0859261d_3d92_4926_96ad_252a1e1b2c1f" name="d_pore" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore size between collagen fibers (decreases with density)</body>
        </notes>
      </parameter>
      <parameter id="mw3baee2b7_1d8e_4ca7_b65d_ffc2349ee292" name="H_pore_T" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based T cell exclusion. 1=fully excluded, 0=free migration.</body>
        </notes>
      </parameter>
      <parameter id="mw245be97c_b842_4af4_b3cb_c16c5f8fad89" name="H_pore_APC" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based APC exclusion. DCs more deformable than T cells.</body>
        </notes>
      </parameter>
      <parameter id="mwc4710baa_c1e1_44e2_becd_1bed48e41603" name="E_ref" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference stiffness at phi_col_ref (~1 kPa, dimensionless)</body>
        </notes>
      </parameter>
      <parameter id="mw241c5e57_6bc0_4d64_895e_8b361bcb6c0f" name="n_stiff" value="1.8" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Power law exponent for stiffness-collagen relationship</body>
        </notes>
      </parameter>
      <parameter id="mwc3add5df_9ae1_4a8e_813b_068bda084aa1" name="E_50_Texh" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw51ae2325_02e7_4cf3_adfa_aae9e7eb4b0a" name="n_Texh" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw6e15001d_8c1d_4ed5_922a_b667bdb116b4" name="E_50_fib" value="5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for fibroblast mechanotransduction</body>
        </notes>
      </parameter>
      <parameter id="mweb96aa36_45b3_49b5_99e1_10ccf9203144" name="n_fib" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated fibroblast activation</body>
        </notes>
      </parameter>
      <parameter id="mwd35cacd3_0ba0_442f_8575_4ec124aa8336" name="stiffness" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tissue stiffness (kPa-scaled, dimensionless). Power law of collagen density.</body>
        </notes>
      </parameter>
      <parameter id="mwedeb20ac_e22e_404b_b1e1_c7e8fd764f79" name="H_stiff_Texh" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated T cell exhaustion (chronic mechanosensing, PD-L1)</body>
        </notes>
      </parameter>
      <parameter id="mw85723950_9b10_4c9c_96bf_e0947882710c" name="H_stiff_fib" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated fibroblast activation (YAP/TAZ mechanotransduction)</body>
        </notes>
      </parameter>
      <parameter id="mw7ac578ca_09c7_40fa_b6b0_b92990ee90c7" name="phi_col_50_Kmax" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">phi_collagen for 50% carrying capacity reduction. &gt;1 = ECM barrier never reaches half-max, consistent with stroma-depletion worsening PDAC (Rhim 2014, Ozdemir 2014).</body>
        </notes>
      </parameter>
      <parameter id="mw3335266c_d3c6_47a8_ab22_4778e08e8212" name="phi_col_max" value="0.5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Physical packing ceiling for collagen volume fraction (logistic secretion saturation). ~0.5 = peak fibrillar collagen packing in dense PDAC stroma (placeholder pending primary-source anchor).</body>
        </notes>
      </parameter>
      <parameter id="mwd7645bed_a280_445d_8f9a_e68a780a6aa1" name="K_stiff_niche" value="100000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF population sustained by stiff ECM alone (mechanotransduction niche via YAP/TAZ). Allows fibrotic scar persistence post-therapy.</body>
        </notes>
      </parameter>
      <parameter id="mweaf75e17_0e42_4abc_836c_47560def4705" name="k_stroma_support" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Aggregate stromal contribution scale (global multiplier on subtype-weighted CAF sum in C_max). Constrained by Xu 2010 + Hwang 2008 orthotopic dose-response submodel targets.</body>
        </notes>
      </parameter>
      <parameter id="mwd8df6f75_f035_4e05_8296_a40554f48d38" name="k_stroma_myCAF" value="1.4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-myCAF contribution to cancer C_max. myCAFs build PDAC desmoplasia (collagen/CXCL12/VEGF) — dominant structural CAF subtype (Elyada 2019; Dominguez 2020).</body>
        </notes>
      </parameter>
      <parameter id="mw02e459b2_8fe0_475f_9881_38d7ddab7022" name="k_stroma_iCAF" value="0.28" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-iCAF contribution to cancer C_max. iCAFs are inflammatory secretors (IL-6/CXCL12), low αSMA, located distally from tumor — minimal structural carrying-capacity role (Elyada 2019, Öhlund 2017).</body>
        </notes>
      </parameter>
      <parameter id="mw42b9353d_a67b_41f1_82e6_11f5b8c628f6" name="k_stroma_apCAF" value="0.07" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-apCAF contribution to cancer C_max. apCAFs are rare (&lt;5% of CAFs) MHC-II+ tolerogenic antigen-presenters — predominantly immunomodulatory (induce Treg expansion in antigen-specific manner), not structural (Elyada 2019, Huang 2022 Cancer Cell).</body>
        </notes>
      </parameter>
      <parameter id="mwf2d4e9b1_33fb_4c98_a588_5b4268deb230" name="C_cap0" value="1700000000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Baseline C-independent carrying-capacity floor (cells): parenchymal volume the lesion occupies pre-desmoplasia. UN-ANCHORED fitted structural handle (derivedFrom={}); value 1.7e9 is calibrated as the tumor_fold handle coupled with k_C1_growth~0.008, NOT a literature value. Candidate future submodel anchor: accessible parenchymal/lobular volume / vol_cell (queued in reconciliation_targets.csv) -- but GitHub #229 (V_T&lt;-&gt;C_max unification) would DERIVE and dissolve it. Default 0 recovers prior stroma+vascular-only C_max exactly.</body>
        </notes>
      </parameter>
      <parameter id="mwb2f0e0c8_236a_4964_98d2_90be8eb0e7a4" name="vol_qPSCcell" value="1500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of quiescent PSC</body>
        </notes>
      </parameter>
      <parameter id="mwff75823b_7ae7_45cd_86b2_dce8b5d3b314" name="vol_iCAFcell" value="2000" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of iCAF</body>
        </notes>
      </parameter>
      <parameter id="mw518ae69c_a369_48c4_8594_8e2fc95ff69d" name="vol_myCAFcell" value="3500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
