          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for overall checkpoint inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mwa5921386_33a1_4043_a942_b88f113eed49" name="H_PD1_M" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for PD1-mediated inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw84798db9_e0b3_43fe_84ed_672d648f5160" name="H_SIRPa" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for SIRPa-mediated inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mwaa3c1469_575a_4712_bc21_483ea1f2a9bb" name="C_CD47" value="400" units="MWDERIVEDUNIT_molecule__micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CD47 expression on cancer cells </body>
        </notes>
      </parameter>
      <parameter id="mw950fb8b3_a445_44ab_9bd9_ed0af5de7852" name="M_PD1_total" value="12500" units="MWBUILTINUNIT_molecule" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">PD-1 expression on macrophages </body>
        </notes>
      </parameter>
      <parameter id="mw57612637_4239_4870_8803_9a795dc388f6" name="M_SIRPa" value="100" units="MWDERIVEDUNIT_molecule__micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">SIRPa expression on macrophages </body>
        </notes>
      </parameter>
      <parameter id="mwc8eb36c2_4025_4d96_8d07_1c32fa9e8f61" name="A_Mcell" value="1385.4423602331" units="MWDERIVEDUNIT_micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Surface area of the macrophage </body>
        </notes>
      </parameter>
      <parameter id="mwee191467_4bb0_41ea_b74b_02bf817b2fe5" name="IL10_50_phago" value="270" units="MWBUILTINPREFIX_pico_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal IL-10 level for phagocytosis by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw2a04c520_8aec_4443_b88b_060fb894d0a6" name="K_M1_phago" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Association coefficient for macrophage and cancer cell </body>
        </notes>
      </parameter>
      <parameter id="mwd2630fb5_9d08_4c4a_96ec_d232970fadb7" name="M_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of macrophages </body>
        </notes>
      </parameter>
      <parameter id="mwa56dbdd4_149d_4739_9d77_3d7ceb8f37cb" name="H_IL10_APC" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill: IL-10 suppression of DC maturation (cDC1/cDC2)</body>
        </notes>
      </parameter>
      <parameter id="mw3597efbd_c3c9_4338_a88e_0788b226ec83" name="H_IL10_Treg" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill: IL-10 amplification of Treg-mediated CD8 exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw36c73130_03c2_442a_bb80_1a3be56341e4" name="H_IL10_phago" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL10-mediated inhibition on phagocytosis </body>
        </notes>
      </parameter>
      <parameter id="mw642abf92_bfda_4d34_8423_5da640921cab" name="H_IL12" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL12 </body>
        </notes>
      </parameter>
      <parameter id="mwf8c5e095_e681_4093_9bf9_d809847f0d14" name="H_IL6_M2" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL-6 promotion of M2 macrophage polarization</body>
        </notes>
      </parameter>
      <parameter id="mw68b9b52c_0f73_4767_960f_2009c0b0bdc8" name="phi_M2_skew" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Averaged M2-polarizing milieu drive (TGFb/IL-10/IL-6); sets both the fraction of recruited monocytes differentiating directly to M2 and the M1-&gt;M2 polarization drive</body>
        </notes>
      </parameter>
      <parameter id="mw1f6002f5_3b50_472b_9a2a_20a09f94ef9e" name="k_CAF_encounter" value="1000000" units="MWDERIVEDUNIT_cell__milliliter_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of encountering resident PSCs as tumor expands into pancreas</body>
        </notes>
      </parameter>
      <parameter id="mw8cb37780_684a_4ccb_8a0d_bfd3deae6ec6" name="k_CAF_const" value="2000000" units="MWDERIVEDUNIT_cell__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Constitutive PSC density in pancreatic tissue</body>
        </notes>
      </parameter>
      <parameter id="mwd5143978_bfd8_4b3b_a30b_c68e068d3d98" name="k_PSC_to_myCAF" value="0.2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;myCAF activation rate (TGFb-driven)</body>
        </notes>
      </parameter>
      <parameter id="mwfdf601d0_4bd5_4de1_85e6_b12eda3d9832" name="k_PSC_to_iCAF" value="0.2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;iCAF activation rate (IL-1-driven)</body>
        </notes>
      </parameter>
      <parameter id="mw9f719c56_4f7c_4ac3_94c1_4bc61925fa43" name="k_PSC_to_apCAF" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;apCAF activation rate (constitutive low)</body>
        </notes>
      </parameter>
      <parameter id="mw1ae33601_cf41_4a89_ab5b_ec50969c9b5b" name="k_iCAF_to_myCAF" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF-&gt;myCAF interconversion (TGFb-driven)</body>
        </notes>
      </parameter>
      <parameter id="mwc32fede5_7457_48dd_867e_cce8af46a165" name="k_myCAF_to_iCAF" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">myCAF-&gt;iCAF interconversion (IL-1-driven)</body>
        </notes>
      </parameter>
      <parameter id="mw79526253_6c5d_4e92_ad9c_8377e1c16bf1" name="k_myCAF_prolif" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">myCAF proliferation rate</body>
        </notes>
      </parameter>
      <parameter id="mw8d817a9b_9636_4cb0_91e1_0ae729ca3bd4" name="k_iCAF_prolif" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF proliferation rate</body>
        </notes>
      </parameter>
      <parameter id="mw10f28997_f5c6_4222_9bf5_282f51c58d69" name="k_apCAF_prolif" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">apCAF proliferation rate (lower than iCAF/myCAF)</body>
        </notes>
      </parameter>
      <parameter id="mwb91872f9_6646_41df_81a2_61f00d61abb1" name="f_stroma_max" value="2.43" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF:cancer ratio — total carrying-capacity budget partitioned across iCAF/myCAF/apCAF</body>
        </notes>
      </parameter>
      <parameter id="mwee4b8587_0421_466c_9c92_6b59b809abba" name="f_apCAF_of_total" value="0.1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">apCAF share of the total CAF carrying capacity. Default 0.1 from Elyada 2019 Fig 5D (apCAFs ~10% of PDAC CAFs). Free parameter in the stick-breaking simplex parameterization (paired with f_iCAF_of_non_apCAF).</body>
        </notes>
      </parameter>
      <parameter id="mw7ea48d54_4cab_40f6_be23_d56a696f2b55" name="f_iCAF_of_non_apCAF" value="0.222" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF share of the non-apCAF CAF mass (stick-breaking second step). Default 0.222 from Elyada 2019 Fig 5D — myCAF 0.7 + iCAF 0.2 of total → iCAF/(iCAF+myCAF) = 0.2/0.9 = 0.222. Free parameter in the stick-breaking simplex parameterization (paired with f_apCAF_of_total).</body>
        </notes>
      </parameter>
      <parameter id="mw2c05a5a7_38d3_4828_b8b7_02df51ef263f" name="k_col_myCAF_sec" value="5e-08" units="MWDERIVEDUNIT_milligram__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwbbc06aa7_3364_40ab_8fef_17d1a80cb40f" name="f_col_basal" value="0.15" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Basal fraction of collagen secretion (TGFb-independent)</body>
        </notes>
      </parameter>
      <parameter id="mw7a33ef3a_c70f_41d6_9fba_00c906cd69d1" name="TGFb_50_CAF_act" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for CAF activation and interconversion</body>
        </notes>
      </parameter>
      <parameter id="mw68ebe31b_2388_4114_a0d3_578f77adf763" name="TGFb_50_col_sec" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for collagen secretion</body>
        </notes>
      </parameter>
      <parameter id="mweaa355be_433a_4a56_b5c0_b48334521c61" name="k_col_deg" value="0.007" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Constitutive collagen degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw0433eb02_736f_4a36_98e1_c56e9e68672b" name="k_MMP_M2" value="1e-08" units="MWDERIVEDUNIT_milliliter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">M2 macrophage MMP-mediated collagen degradation</body>
        </notes>
      </parameter>
      <parameter id="mw8f49837d_ae33_4beb_80d3_6d3ceede84c8" name="phi_cross_50" value="0.03" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction at 50% MMP-susceptibility (LOX-crosslinking shield)</body>
        </notes>
      </parameter>
      <parameter id="mw7baa0168_8c07_42a0_88a5_b50287a3400b" name="f_nascent" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Fraction of collagen susceptible to M2 MMP degradation (non-crosslinked)</body>
        </notes>
      </parameter>
      <parameter id="mw5c1c062d_394a_422f_9d12_a85ae7a19122" name="rho_collagen" value="0.103" units="MWDERIVEDUNIT_gram__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen packing density (material constant)</body>
        </notes>
      </parameter>
      <parameter id="mwdcaf8620_4968_4ffb_80c4_ba42a103c9f6" name="phi_collagen" value="0.12" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction (0-1). Bare-volume normalized; primary input for all ECM Hill functions.</body>
        </notes>
      </parameter>
      <parameter id="mw23b02459_e6ed_45c5_a1f4_707be0e4ec76" name="k_qpsc_death" value="0.005" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of quiescent PSCs</body>
        </notes>
      </parameter>
      <parameter id="mwe9d0d408_2628_4578_914f_492c9a59ba9d" name="k_iCAF_death" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw0972a8d8_c2d8_4b19_9767_6608e9dc193a" name="k_myCAF_death" value="0.015" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw1875e21a_8918_407e_ab75_4778f2011729" name="k_apCAF_death" value="0.03" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw992bb67f_98af_4bd9_9870_34bdcce0d767" name="d_pore_ref" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference pore size in normal pancreas (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mwaf2e7164_0473_4880_86ed_d768ef5cb3cb" name="phi_col_ref" value="0.046" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction in normal pancreas (reference)</body>
        </notes>
      </parameter>
      <parameter id="mw7f219d2a_0251_4083_be91_8be464457f1b" name="d_crit_T" value="2.3" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for T cell migration arrest (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mw5454ea9c_4426_47d7_bb50_4138247f3cc7" name="d_crit_APC" value="2.1" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for APC migration arrest (podosome/MMP migration)</body>
        </notes>
      </parameter>
      <parameter id="mw40a813d0_afac_4dc3_8880_92db3b3607db" name="n_pore" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for pore-size exclusion sharpness</body>
        </notes>
      </parameter>
      <parameter id="mwda64f21a_67ac_49c7_9907_a09023433785" name="d_pore" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore size between collagen fibers (decreases with density)</body>
        </notes>
      </parameter>
      <parameter id="mw4ae0d06d_db6c_46a8_8508_f8b69d03cdad" name="H_pore_T" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based T cell exclusion. 1=fully excluded, 0=free migration.</body>
        </notes>
      </parameter>
      <parameter id="mw09343b2f_ac72_4d39_b37a_c493872e3223" name="H_pore_APC" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based APC exclusion. DCs more deformable than T cells.</body>
        </notes>
      </parameter>
      <parameter id="mw1c543b13_af4e_4a22_863c_df8d7cd98939" name="E_ref" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference stiffness at phi_col_ref (~1 kPa, dimensionless)</body>
        </notes>
      </parameter>
      <parameter id="mw53ce3e6e_0bd9_4935_bacd_32f42563160f" name="n_stiff" value="1.8" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Power law exponent for stiffness-collagen relationship</body>
        </notes>
      </parameter>
      <parameter id="mw71ef3e80_366d_4f43_a564_a653a9568eaf" name="E_50_Texh" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwad29ef55_7517_408a_aa73_8de266c3dc64" name="n_Texh" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw3359f1ee_d2e1_4cfe_95d4_0048341fdaac" name="E_50_fib" value="5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for fibroblast mechanotransduction</body>
        </notes>
      </parameter>
      <parameter id="mwe3c65d00_1bfc_4e6a_a054_da4200f4e68d" name="n_fib" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated fibroblast activation</body>
        </notes>
      </parameter>
      <parameter id="mw07205efc_db9b_4fae_9c98_88ae1a09fe64" name="stiffness" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tissue stiffness (kPa-scaled, dimensionless). Power law of collagen density.</body>
        </notes>
      </parameter>
      <parameter id="mw1f57b5c0_5a22_4a97_b387_403889835eae" name="H_stiff_Texh" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated T cell exhaustion (chronic mechanosensing, PD-L1)</body>
        </notes>
      </parameter>
      <parameter id="mw56f1ef4c_8119_447c_86fd_ad4fc0c57bb6" name="H_stiff_fib" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated fibroblast activation (YAP/TAZ mechanotransduction)</body>
        </notes>
      </parameter>
      <parameter id="mw892a1bfc_f814_40a8_b11e_af120fb17290" name="phi_col_50_Kmax" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">phi_collagen for 50% carrying capacity reduction. &gt;1 = ECM barrier never reaches half-max, consistent with stroma-depletion worsening PDAC (Rhim 2014, Ozdemir 2014).</body>
        </notes>
      </parameter>
      <parameter id="mw69f571ef_0a87_41ef_981f_82dc34192be0" name="phi_col_max" value="0.5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Physical packing ceiling for collagen volume fraction (logistic secretion saturation). ~0.5 = peak fibrillar collagen packing in dense PDAC stroma (placeholder pending primary-source anchor).</body>
        </notes>
      </parameter>
      <parameter id="mw97ead638_ffd5_4a62_b508_cfda1650927f" name="K_stiff_niche" value="100000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF population sustained by stiff ECM alone (mechanotransduction niche via YAP/TAZ). Allows fibrotic scar persistence post-therapy.</body>
        </notes>
      </parameter>
      <parameter id="mw8ed47bf3_ae8b_490e_80c0_fba057701aa9" name="k_stroma_support" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Aggregate stromal contribution scale (global multiplier on subtype-weighted CAF sum in C_max). Constrained by Xu 2010 + Hwang 2008 orthotopic dose-response submodel targets.</body>
        </notes>
      </parameter>
      <parameter id="mw110b29dd_526c_403a_8494_f8f7cf36d292" name="k_stroma_myCAF" value="1.4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-myCAF contribution to cancer C_max. myCAFs build PDAC desmoplasia (collagen/CXCL12/VEGF) — dominant structural CAF subtype (Elyada 2019; Dominguez 2020).</body>
        </notes>
      </parameter>
      <parameter id="mw5abe26c7_9924_433d_a2de_a13748902882" name="k_stroma_iCAF" value="0.28" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-iCAF contribution to cancer C_max. iCAFs are inflammatory secretors (IL-6/CXCL12), low αSMA, located distally from tumor — minimal structural carrying-capacity role (Elyada 2019, Öhlund 2017).</body>
        </notes>
      </parameter>
      <parameter id="mwb9234685_3877_40be_9934_be8b8e25ccf5" name="k_stroma_apCAF" value="0.07" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-apCAF contribution to cancer C_max. apCAFs are rare (&lt;5% of CAFs) MHC-II+ tolerogenic antigen-presenters — predominantly immunomodulatory (induce Treg expansion in antigen-specific manner), not structural (Elyada 2019, Huang 2022 Cancer Cell).</body>
        </notes>
      </parameter>
      <parameter id="mw1f1c7999_9f77_4ca8_a3f7_1a0ad33fb6c2" name="C_cap0" value="1700000000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Baseline C-independent carrying-capacity floor (cells): parenchymal volume the lesion occupies pre-desmoplasia. UN-ANCHORED fitted structural handle (derivedFrom={}); value 1.7e9 is calibrated as the tumor_fold handle coupled with k_C1_growth~0.008, NOT a literature value. Candidate future submodel anchor: accessible parenchymal/lobular volume / vol_cell (queued in reconciliation_targets.csv) -- but GitHub #229 (V_T&lt;-&gt;C_max unification) would DERIVE and dissolve it. Default 0 recovers prior stroma+vascular-only C_max exactly.</body>
        </notes>
      </parameter>
      <parameter id="mw338692e4_f55a_49d3_9778_b4f6d2a00b70" name="vol_qPSCcell" value="1500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
