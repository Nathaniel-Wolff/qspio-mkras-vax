    <listOfParameters>
      <parameter id="mw708841cf_df51_4de0_a083_cff10cba9b9b" name="k_cell_clear" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of dead cell clearance from tumour compartment</body>
        </notes>
      </parameter>
      <parameter id="mwace2aa05_ad49_4ae2_8b40_0eea78bc3b32" name="cell" value="1" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">unit parameter for calculation</body>
        </notes>
      </parameter>
      <parameter id="mwdf817f98_d908_46f1_a737_9399b0ce2077" name="day" value="1" units="MWBUILTINUNIT_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">unit parameter for calculation</body>
        </notes>
      </parameter>
      <parameter id="mw2777894f_8da0_4e7b_a522_d004079b32db" name="D_cell" value="17" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average diameter of cancer cell</body>
        </notes>
      </parameter>
      <parameter id="mwdd0f6826_16c4_4679_a917_2ca4d60e6fb0" name="vol_cell" value="2572.44078451444" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average volume of cancer cell</body>
        </notes>
      </parameter>
      <parameter id="mw14ce6a26_bab4_4726_8ef2_3a786b57bf75" name="vol_Tcell" value="175.015709799539" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average volume of T cells</body>
        </notes>
      </parameter>
      <parameter id="mw2e164e63_e03d_42a5_9f0a_460156526f52" name="Ve_T" value="0.37" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Intracellular fraction of the tumor</body>
        </notes>
      </parameter>
      <parameter id="mw78f0b843_c132_4bae_b7de_7b2cc2f7dcb7" name="V_Tmin" value="1e-06" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_liter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Minimum tumor compartment volume (cancer-free baseline)</body>
        </notes>
      </parameter>
      <parameter id="mw9fd0aa0b_f26a_45ef_9de6_6e43ef433d92" name="C_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of cancer cells</body>
        </notes>
      </parameter>
      <parameter id="mw4403967d_e66c_4e99_90c0_c7de64757f7f" name="T_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of activated T cells in tumor</body>
        </notes>
      </parameter>
      <parameter id="mw2938eb10_182c_42e1_adb3_567d8b24f435" name="T_total_LN" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of activated T cells in TDLNs</body>
        </notes>
      </parameter>
      <parameter id="mw22f949dc_8d11_4e01_9b7e_55283eed1aa4" name="R_Tcell" value="1" units="MWDERIVEDUNIT_cell__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of cancer cell death</body>
        </notes>
      </parameter>
      <parameter id="mwd6d52a8b_f0ee_4b52_8050_4f2da79fe2c9" name="Tregs_" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of Tregs in tumor compartment (V_T.Treg)</body>
        </notes>
      </parameter>
      <parameter id="mwa3a9800d_9ee5_4e3c_acdb_65f1566a3965" name="H_APC_Treg" value="0.5" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of cDC2 for Treg activation (shared nCD4 pool, self-antigen)</body>
        </notes>
      </parameter>
      <parameter id="mwfd871ddd_d4d9_4851_812a_2fcaefe47da8" name="H_PD1_C1" value="0.9" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of PDL1 on chemotherapy-sensitive tumor cells for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwfc37932b_f786_44fe_95e5_9d247f1dda5c" name="H_PD1_APC" value="0.9" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of PDL1 on APC for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwbc486640_9a8f_44a4_9427_b7cf4d96805a" name="H_CD28_C1" value="0.1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of CD28 on tumor cells</body>
        </notes>
      </parameter>
      <parameter id="mw0dca7697_e24f_4686_8f25_c4b532185dd0" name="H_CD28_APC" value="0.1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of CD28 on APCs for T cell activation</body>
        </notes>
      </parameter>
      <parameter id="mw3d71261e_6b3d_40a5_9d21_3a637645eb48" name="k_C1_growth" value="0.008" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cancer growth rate</body>
        </notes>
      </parameter>
      <parameter id="mw35f48059_ddfe_44a6_99f2_6d17dcb93917" name="k_C1_death" value="0.003" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cancer death rate</body>
        </notes>
      </parameter>
      <parameter id="mwbdd59356_436c_450e_bcba_37b1ec1bca6c" name="C_max" value="27000" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Aggregate tumor carrying capacity (Gompertzian denominator). Initialized = K_vasc here, then RE-DEFINED in fibroblast_module_enhanced to (C_cap0 + K_vasc + CAF stromal support) * collagen barrier.</body>
        </notes>
      </parameter>
      <parameter id="mwcc2fb54b_2da8_4990_a724_a80b708f220e" name="k_C1_therapy" value="0" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Therapy-induced death rate</body>
        </notes>
      </parameter>
      <parameter id="mw8a760364_c5ba_4ced_a8f3_8e933498a40b" name="initial_tumour_diameter" value="3.2" units="MWBUILTINPREFIX_centi_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pre-treatment tumor diameter</body>
        </notes>
      </parameter>
      <parameter id="mw755bef2c_631f_4af1_8b02_d41be3ab62d5" name="K_initial" value="10300" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Initial tumor carrying capacity</body>
        </notes>
      </parameter>
      <parameter id="mwff75893a_a479_4c11_b322_35629ca504ea" name="k_vas_growth" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor vasculature growth rate</body>
        </notes>
      </parameter>
      <parameter id="mw4159e7b3_b89e_4ce7_ba79_9d490272ba0c" name="k_vas_decay" value="0.0001" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor vasculature inhibition rate</body>
        </notes>
      </parameter>
      <parameter id="mwa10837df_6f9c_43d0_8ab3_712dbc93c655" name="vas_inhib_vol_scale" value="2.57e-06" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-cell tumor-volume scaling (cancer cell volume in mm^3 ~ 4/3*pi*(D_cell/2)^3*1e-9) for the Hahnfeldt 1999 V^(2/3) endogenous vascular-inhibition surface term (PMID 10519381).</body>
        </notes>
      </parameter>
      <parameter id="mwf167d2a2_e319_46e6_9308_5754a3a2cde6" name="k_vas_Csec" value="0.1" units="MWDERIVEDUNIT_picogram__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor secretion rate</body>
        </notes>
      </parameter>
      <parameter id="mwff8f1f75_9a57_4824_a0f8_271d731c1f74" name="k_vas_deg" value="16.6" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mwf2f9c8e7_81c8_4030_9494_011835a5cf36" name="VEGF_50" value="2410" units="MWDERIVEDUNIT_picogram__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal angiogenic factor concentration for tumor capacity growth</body>
        </notes>
      </parameter>
      <parameter id="mw84764bb0_d3bb_4d10_8635_dbb3d8f3ad70" name="div_Treg" value="1160000" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">T Cell Diversity </body>
        </notes>
      </parameter>
      <parameter id="mw1ffb76fb_4f96_496e_9db5_216924e4c95c" name="n_CD4_clones" value="100" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Number of self-antigen-specific T cell clones </body>
        </notes>
      </parameter>
      <parameter id="mwe02a5f68_4239_4d74_a3a0_00341ce8d5c7" name="q_nCD4_LN_in" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of naive T cell transport into the LN </body>
