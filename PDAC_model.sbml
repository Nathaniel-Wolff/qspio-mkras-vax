        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <apply>
                <divide/>
                <apply>
                  <times/>
                  <ci> mw1956b4e4_3d3b_48af_bd1e_5005cbd85301 </ci>
                  <ci> mwc88d001b_6503_4db3_ab1b_0c8de4d13518 </ci>
                  <ci> mwf9c5b284_7b20_47cc_8b67_0d0c8d983dde </ci>
                </apply>
                <apply>
