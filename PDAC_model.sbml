      <parameter id="mwc253c4db_0f07_4047_bff8_c883855e23c7" name="H_IL1_eff" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Effective IL-1 Hill function. TGFb antagonizes by increasing effective EC50 via IL-1R1 repression (saturating).</body>
        </notes>
      </parameter>
      <parameter id="mwd600942c_55cd_4dd8_a836_e216d8bd38a8" name="k_vas_myCAF_sec" value="0.002" units="MWDERIVEDUNIT_picogram__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwa797664d_dd08_4e3b_8242_29b48ccef006" name="k_apCAF_iTreg" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Effective antigen-specific induced-Treg rate via apCAF presentation</body>
        </notes>
      </parameter>
      <parameter id="mw75e765ee_a95c_49b4_a50f_a21821034546" name="P1_50_apCAF" value="1e-09" units="MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for antigen-dependent Treg induction by apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw1565964d_3077_4245_bf99_75c905a80191" name="aPSC_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total activated PSC count (iCAF+myCAF+apCAF). Backward compatibility for test statistics.</body>
        </notes>
      </parameter>
      <parameter id="mw37a1ee3b_f38b_4763_9529_307fb2486a2a" name="k_TGFb_sec_myCAF" value="2e-10" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGF-β secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwa9b8a56a_fe55_4391_8691_e08530c1de16" name="k_CXCL12_sec_cancer" value="5e-11" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 secretion rate by tumor cells</body>
        </notes>
      </parameter>
      <parameter id="mw2bb27bf8_032b_4eec_b9c8_4adf726ea871" name="H_apCAF_pMHCII" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Quasi-steady antigen-presentation gate for apCAF MHC-II-dependent Treg induction</body>
        </notes>
      </parameter>
      <parameter id="mw53bb5bc7_69a0_447e_b4a1_08bdba2a87ac" name="k_GVAX_clearance" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GVAX cell clearance rate from tumor</body>
        </notes>
      </parameter>
      <parameter id="mw61344880_5e99_4516_a74d_09b84bd3d45a" name="V_ID_volume" value="0.0001" units="MWBUILTINUNIT_liter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of intradermal injection site (~0.1 mL)</body>
        </notes>
      </parameter>
      <parameter id="mw8fd9fdd6_f7af_4b55_9016_a8092fa3e35d" name="k_GMCSF_prod" value="1e-08" units="MWDERIVEDUNIT_nanomolarity__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF production rate per GVAX cell per day</body>
        </notes>
      </parameter>
      <parameter id="mw82ca7f91_7bf9_4071_8450_65bf772c3d87" name="k_GMCSF_deg" value="5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF degradation/clearance rate (half-life ~3 hours)</body>
        </notes>
      </parameter>
      <parameter id="mwe620ae11_d7ee_445e_8749_cfd14f9152e2" name="k_APC_recruit_ID" value="100000" units="MWDERIVEDUNIT_cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC recruitment rate to intradermal injection site</body>
        </notes>
      </parameter>
      <parameter id="mwea7fe5fb_307e_420c_9424_4b11a25e97fb" name="EC50_GMCSF" value="0.00294005042817446" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for GM-CSF-mediated APC recruitment and maturation</body>
        </notes>
      </parameter>
      <parameter id="mwb63dd501_aeb6_4674_aa37_036bf3057348" name="k_APC_mature_ID" value="2.72805986290677" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC maturation rate at injection site</body>
        </notes>
      </parameter>
      <parameter id="mw2da75f98_eef8_446b_977c_00e67b998410" name="k_APC_mig_ID_LN" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC migration rate from injection site to lymph nodes</body>
        </notes>
      </parameter>
      <parameter id="mwf4aa92fd_bbeb_499d_a631_a7cd68f98096" name="k_APC_death_ID" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC death rate at injection site</body>
        </notes>
      </parameter>
      <parameter id="mwa82ac418_b1fc_40f4_9efa_0ef830c94d09" name="sigma_P1_per_mAPC" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen consumed per APC maturation event at injection site</body>
        </notes>
      </parameter>
      <parameter id="mwfe6f8b21_996b_44a0_b8ad_908f4c8ab1b6" name="EC50_P1_mature" value="0.1" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for antigen-dependent APC maturation. Lowered from 10 nM to 0.1 nM on 2026-04-21 (Fix 3): with the 10 nM value, V_ID.P1_GVAX (~0.009 nM steady state) produced a Hill factor of ~0.0009 in J_mature_ID, so GVAX-derived antigen was never a meaningful contributor to APC maturation — maturation proceeded almost entirely via the GMCSF + baseline APC terms. 0.1 nM is an estimated value in the nanomolar-affinity range typical of peptide/antigen-receptor interactions; not anchored to a specific primary source. Candidate for submodel-target extraction.</body>
        </notes>
      </parameter>
      <parameter id="mw46b325e1_abb1_4b7a_94e4_67defc05c670" name="K_APC_ID" value="1000000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mwe470f048_ea72_4504_ab8a_528be9430e84" name="k_APC_recruit0" value="100" units="MWDERIVEDUNIT_cell__day" constant="true"/>
      <parameter id="mw5026d473_9906_48ba_8d35_dda9e3a86b2e" name="k_mAPC_death_ID" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mwf2a10256_d6c1_4c85_ae80_d58ed34cc342" name="y_Ag_per_cell" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true"/>
      <parameter id="mw0378e272_d475_4c40_a631_267ae53c9376" name="k_P1_deg_ID" value="10" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mw7c70b900_74a4_4284_96b8_c82d7ba672af" name="K_APC_mig" value="100000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mw619e93dd_f17d_483d_83d3_1e9c128f85ac" name="k_cDC1_Ag_transfer" value="1e-07" units="MWDERIVEDUNIT_1__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen-transfer rate constant: migratory mcDC2 -&gt; resident cDC1 cross-licensing (Ferris 2022 PMID: 35648641; Mueller 2017 Eur J Immunol)</body>
        </notes>
      </parameter>
      <parameter id="mwfa9ddb5b_1507_4d04_ad49_3ae60adbb8f8" name="k_GVAX_present" value="14.4" units="MWDERIVEDUNIT_1__day__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Vaccine-antigen presentation-uptake rate into the shared endosomal pMHC pool; parallel to tumor k_up=14.4 (audit consensus #2, GVAX-&gt;H_P1 coupling); placeholder centered at k_up, SBI-varied, submodel anchor pending</body>
        </notes>
      </parameter>
      <parameter id="mw2316f9f4_b821_4b0c_a6ba_6951ae8985e4" name="H_GMCSF_ID" value="0" units="dimensionless" constant="false"/>
      <parameter id="mw3714b926_7908_4fb8_bd62_d805aa3d544d" name="HMGB1_50_ID" value="10000000" units="MWDERIVEDUNIT_cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max death FLUX (cell/day) for HMGB1 (DAMP)-mediated APC maturation at the GVAX injection depot; anchored to the depot operating death flux (~5e7 cell/day peak) so H_HMGB1_ID sits responsive. Literature-anchor route deferred (HMGB1_50_ID = EC50*k_deg*V_ID/q_release).</body>
        </notes>
      </parameter>
      <parameter id="mw28e064d2_1aa6_4764_85bb_c865fd05d347" name="H_HMGB1_ID" value="0" units="dimensionless" constant="false"/>
      <parameter id="mw33bd5ec4_df83_4aca_b487_3d602c9c8b29" name="J_mature_ID" value="0" units="MWDERIVEDUNIT_cell__day" constant="false"/>
      <parameter id="mw16e785da_014c_40e1_b098_081a7dc71389" name="f_epitope_spread" value="4.89897948556636" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Shared effective fold-broadening of tumor-specific CD4 and CD8 repertoires under saturating GVAX antigen (qualitatively anchored to Thomas 2004 PMID 15289501; geometric-mean initial value; estimated and requires reduced-model refit).</body>
        </notes>
      </parameter>
      <parameter id="mw51862d74_adb3_471d_a440_bbeef3aacd65" name="H_P1_spread" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Vaccine-antigen Hill gating epitope-spreading clonal recruitment (Path A); 0 at diagnosis</body>
        </notes>
      </parameter>
      <parameter id="mweaae0249_3466_4b21_933b_1f863bd20c06" name="k_Cy_clear" value="2.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide clearance rate</body>
        </notes>
      </parameter>
      <parameter id="mw3e0db9b2_0d28_4e08_a8fe_e5a26949df72" name="k_Cy_Treg_deplete" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Maximum Treg depletion rate by cyclophosphamide</body>
        </notes>
      </parameter>
      <parameter id="mwee7b9a0d_3061_48f0_8d5f_0921bc978f7a" name="Cy_50_Treg" value="50" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_gram" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide concentration for 50% Treg depletion</body>
        </notes>
      </parameter>
      <parameter id="mw8d423ba4_3418_4609_b89a_1683eca8d9ba" name="k_Cy_eff_decay" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Decay rate of the cyclophosphamide durable PD effect compartment (sets Treg-suppression duration)</body>
        </notes>
      </parameter>
      <parameter id="mw66605c8f_b75a_42fd_b002_d168ad7b32b9" name="Emax_Cy_Treg" value="0.8" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Maximum fractional suppression of tumor-Treg proliferation by the Cy effect compartment</body>
        </notes>
      </parameter>
      <parameter id="mwa09b44b9_7362_45e3_b8dd_266e9a26a575" name="k_Cy_on" value="10" units="MWDERIVEDUNIT_milligram__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Build rate of the cyclophosphamide effect compartment from drug exposure (structural; weakly identifiable, fixed)</body>
        </notes>
      </parameter>
      <parameter id="mw84df0677_92c4_4274_b3a4_eaaf4a881ed4" name="Cy_eff_50" value="1" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_gram" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-saturation of the Cy effect compartment on tumor-Treg proliferation (structural; weakly identifiable, fixed)</body>
        </notes>
      </parameter>
      <parameter id="mw9fe185b1_03f4_4954_b433_bc12b4d0271b" name="CD137_50" value="0.3" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal TUMOR urelumab concentration for CD137/4-1BB engagement of the TLA-local CD8 activation-state conversion (H_CD137_T). ESTIMATED ~1 nM from 8 mg flat-dose PK; affinity-anchorable to the Leitner 4-1BB system. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mw6b5ad741_4d3b_4fb6_bd36_78f6e36849bd" name="k_CXCL13_sec" value="1e-06" units="MWDERIVEDUNIT_nanomole__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL13 secretion per GVAX-depot matured DC (V_ID.mAPC). ESTIMATED; lit-anchorable to in vitro DC CXCL13 production. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mw111b95f1_a114_4d15_beae_c87f0a9905ee" name="k_CXCL13_ff" value="1e-07" units="MWDERIVEDUNIT_nanomole__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL13 feed-forward from TLA-resident CD8 (sustains the aggregate after depot clearance; makes prevalence switch-like). ESTIMATED. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mwbbd3869e_92a9_434e_85f6_ea9fffb3ead0" name="k_CXCL13_deg" value="10" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL13 first-order degradation/clearance. ESTIMATED; lit-anchorable to chemokine half-life. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mw4119a645_0618_48a3_8af6_1089492b1948" name="CXCL13_50_TLA" value="0.0002" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal CXCL13 for TLA niche formation. PHENOMENOLOGICAL threshold on the model-internal CXCL13 signal (~500x below real biochemical CXCL13 because the FDC-like organizer cell is not modeled). The Cosgrove2020 B-cell-chemotaxis submodel anchor was demoted (wrong quantity, wrong scale; see submodel_targets/excluded/README.md and notes/model/tla_cxcl13_urelumab_investigation.md). CSV-only wide prior; SBI fits it against within-TLA CD8 targets. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mw46d0c150_4f3f_49bd_9793_b4e315115c64" name="k_TLA_form" value="0.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TLA niche formation rate (logistic toward a CXCL13-set ceiling, dimensionless niche fraction capped at 1). ESTIMATED; pinned by TLA prevalence/timing (Li/Lutz). Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mw8bd4df25_fcaf_4680_b234_45e243e8bd45" name="k_TLA_decay" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TLA niche dissolution/regression rate. ESTIMATED; lit-anchorable to TLS turnover. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mw9f0fe696_ef8c_44a9_b5f5_6a9c50e1600d" name="k_TLA_seq" value="0.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of intratumoral CD8 sequestration into the TLA niche (scaled by the TLA area fraction a_TLA, NOT the 0-1 niche-formation dial TLA). ESTIMATED; identified by the LA/non-LA CD8 density-ratio submodel target via the product k_TLA_seq*a_TLA. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mwa0b45c76_8056_47bc_99d3_811f09ebfe4d" name="k_TLA_release" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of within-TLA CD8 return to the bulk intratumoral pool. ESTIMATED. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mw77531197_e9e3_471c_babe_61a59839f0b3" name="a_TLA" value="0.0055" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TLA area fraction of the tumor (Hiraoka 2015: intratumoral TLO area 0.1-1%% of tumor for grade 3, midpoint 0.55%%). Scales CD8 sequestration into the niche so the count partition CD8_TLA/CD8 = k_TLA_seq*a_TLA/(k_TLA_release+k_CD8_death) matches the tla_seq_release_partition submodel target, which uses this same Hiraoka value. FIXED constant, NOT varied in SBI: only the product k_TLA_seq*a_TLA is identifiable from the LA/non-LA density ratio, so a_TLA is pinned from data and k_TLA_seq carries the inference. Replaces the prior use of the 0-1 niche-formation dial TLA (~0.82 at QSS) in the sequestration term, which over-sequestered CD8 ~150x and drained the non-LA bulk pool (Li 2022 cd8_pct_nonLA). Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mwd23aa397_73f4_455e_af57_e115e30732cd" name="k_CD137_act" value="1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max rate of CD8_TLA -&gt; CD8_TLA_act conversion (CD137+ activation state) at saturating urelumab. ESTIMATED; lit-anchorable to in vitro 4-1BB-agonism activation timecourse (Leitner). Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mwedccea30_0765_4184_8017_ceb872563b88" name="k_CD137_deact" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of CD8_TLA_act -&gt; CD8_TLA reversion (loss of CD137+ activation state). Durable CD137+ (slow reversion) so the within-TLA activated fraction stays high through d21; with k_CD137_act sets the activated-fraction asymptote (Heumann Arm C). ESTIMATED, free; wide prior. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mw149dd9d0_0319_4fec_a3bf_9ac4ecfb2b49" name="f_act_base" value="0.0015" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Urelumab-independent baseline of the CD137 conversion drive, sets the no-urelumab within-TLA CD137+ fraction (low, between Heumann Arm A ~1.5% and Arm B ~0.6%). Lowered under the new durable-CD137+ regime (slow k_CD137_deact) so the no-urelumab arms stay low. ESTIMATED, free; wide prior; pinned by Arm A/B targets. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mw510e2ee3_5810_4b70_b802_18908ebe054b" name="k_TLA_egress" value="0.03" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of activated within-TLA CD8 (CD8_TLA_act) egress to the neoplastic vicinity (the 2-4% CD137+ subset outside TLA, Fig 5d) as the durable effector pool CD8_vic. ESTIMATED; pinned by the vicinity target. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mwecc05e5a_1aa1_4cc4_990c_07f56fba9d6a" name="phi_vic_kill" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-cell tumor-killing quality multiplier for the egressed vicinity effector pool CD8_vic relative to bulk V_T.CD8 (4-1BB/CD137-agonism upgrades effector QUALITY, not quantity; Heumann 2023 reports flat bulk GZMB density but a survival-associated CD8+CD137+GZMB+ activated-cytotoxic subset that egresses to the neoplastic vicinity, Fig 5d). &gt;1 means vicinity effectors kill better per cell. ESTIMATED, free; wide prior; constrained by the urelumab DFS/OS and Fig-5d vicinity targets. Urelumab-gated downstream (CD8_vic~0 without urelumab), so Arms A/B and no-treatment are untouched. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mw3d13a6a9_f83b_481a_a159_0b244b067de6" name="k_vic_decay" value="0.005" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Turnover of the egressed vicinity effector pool CD8_vic back to bulk V_T.CD8. SLOW (half-life ~139 d at 0.005/day) = effector-memory-like durability: the urelumab vicinity pool is seeded during the brief neoadjuvant urelumab window (single dose, aCD137 clears in weeks) and must PERSIST for months so that, as the vaccine/nivo-driven bulk CD8 contracts post-treatment, the durable throttle-bypassing vicinity pool sustains tumor/recurrence control over the long horizon (the DFS/OS benefit). ESTIMATED, free; wide prior; long-horizon DFS/OS targets pull it. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mwfb38262d_d024_427f_b463_be9bffdf21aa" name="k_CD137_reinvig" value="1.42" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max TOTAL urelumab/4-1BB (CD137-agonist)-driven differentiation rate of progenitor-exhausted (Tpex) CD8 out of the reservoir, at full tumor urelumab occupancy (H_CD137_T). The 4-1BB COSTIMULATION drive on the CD8_pex reservoir, parallel to the anti-PD-1 k_reinvig arm. NOTE (2026-07-15): this is NO LONGER a pure reflux to functional effectors — CD137 agonism drives Tpex proliferation AND terminal differentiation (Pichler 2023, Immunity: TCR-independent CD137 signaling promotes exhausted-CD8 proliferation and terminal differentiation), so the CD137-driven exit flux is fate-split in tla_module (fraction f_CD137_func to functional CD8, remainder to terminal CD8_exh). Captures the synergy with aPD-1 (Muth 2023, Zotero 39X6WHRF: aCD137 + aPD-1 increased IFNg in EOMES+ exhausted TILs). Anchorable from CD137-induced Tpex proliferation/expansion kinetics (the confound that made an isolated reflux fraction unmeasurable). Prior framing as &quot;the dominant urelumab antitumor lever&quot; was falsified by a Heumann-arm trace (moves bulk CD8 &lt;0.5% over 21 days; urelumab antitumor effect rides on the vicinity/quality arm). Urelumab-gated (H_CD137_T=0 without urelumab), so Arms A/B and no-treatment are untouched. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mw2be13ee7_becb_4045_9d31_98c6f33bc5cf" name="f_CD137_func" value="0.24" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Functional (transitory-effector) fraction of the CD137/4-1BB-driven Tpex differentiation flux; (1-f_CD137_func) is the terminal-CD8_exh fraction (Pichler 2023 terminal-dominant skew). Anchorable from the functional:terminal ratio in head-to-head 4-1BB Tpex assays. Used in tla_module (fate-split of reaction 14).</body>
        </notes>
      </parameter>
      <parameter id="mw3d5984d6_c735_441e_92b1_6db8b607d9d1" name="k_CD137_prolif" value="1.55" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CD137/4-1BB-driven Tpex (CD8_pex) proliferation/self-renewal rate at full urelumab occupancy (H_CD137_T); generative null-&gt;CD8_pex, H_CD137_T-gated (zero at baseline/Arms A/B), niche-capped by rho_pex_max. Anchorable from CD137-induced Tpex Ki67/fold-expansion (Li 2023). Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mw93d328cc_26aa_4cd9_a479_826970bdb3a5" name="k_CD8_T_vac_pro" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GVAX-vaccine-gated in-situ tumor CD8 proliferation increment (Path C). Anchored to f*k_CD8_T_pro (f~0.6): the vaccine-differential increment is a bounded fraction of the Blessin-anchored constitutive in-situ rate (k_CD8_T_pro=0.079/day). H_P1_spread-gated (zero without vaccine), saturating in CD8_T_tot density. Prior sigma 0.7 (was 1.5 placeholder). See notes/calibration/vpop_thexh_cd8vac_anchoring_2026-07-23.md.</body>
        </notes>
      </parameter>
      <parameter id="mwc94023a5_8a85_4edc_ac8e_e7d3676d659a" name="k_CD137_latch_on" value="1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate at which urelumab exposure (H_CD137_T) commits the TLA to the durable CD137+ activation program (latch charge, L_CD137). ESTIMATED, free; wide prior. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mwa7a66060_2ad3_4fa9_bf76_af3e02d06895" name="k_CD137_latch_off" value="0.015" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Decay rate of the CD137 activation latch (L_CD137) — the durability of the 4-1BB-induced activation program after urelumab washout (~0.015/day, t1/2 ~6 weeks). Sets how long the within-TLA CD137+ fraction persists post single-dose urelumab (Heumann Arm C d21, 14 d after the dose). ESTIMATED, free; wide prior. Used in tla_module.</body>
        </notes>
      </parameter>
      <parameter id="mwdf72240d_022b_4ebd_911d_26067226b211" name="H_CD137_T" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill of tumor urelumab (V_T.aCD137) gating TLA CD8 CD137-activation</body>
        </notes>
      </parameter>
      <parameter id="mw735fb13d_1e5c_487f_8b2e_debe06722d36" name="L_CD137" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Integrated-exposure latch for durable CD137/4-1BB activation: charges from H_CD137_T during the urelumab window, decays slowly (k_CD137_latch_off) — drives the TLA CD8 activation-state conversion (reaction 8) so the CD137+ fraction persists to d21 after single-dose urelumab washes out</body>
        </notes>
      </parameter>
      <parameter id="mwf3f658ad_5c63_490a_858c_47b9fef8d0fd" name="CXCL13" value="0" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL13 organizer chemokine (quasi-steady; GVAX-depot source + TLA-resident-CD8 feed-forward)</body>
        </notes>
      </parameter>
      <parameter id="mw807835d0_72d0_4955_bdeb_d7a590c7caab" name="H_CXCL13" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill of CXCL13 driving TLA niche formation</body>
        </notes>
      </parameter>
      <parameter id="mw5db5b10f_09fb_4f1b_b1d7_7d81781b99f0" name="TLA" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TLA niche fraction (0-1); intratumoral tertiary lymphoid aggregate presence/size</body>
        </notes>
      </parameter>
      <parameter id="mwdad54bd4_3446_4a3d_936d_a076e6e35be6" name="CD8_T_tot" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total intratumoral CD8 (bulk + within-TLA resting + within-TLA activated + egressed vicinity effector); carrying-capacity denominator</body>
        </notes>
      </parameter>
      <parameter id="mwfbbc5aed_715d_4b95_901a_1e32be159ba3" name="k_C_vic_eff" value="0" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Effective vicinity-effector (CD8_vic) tumor-killing rate; throttle-bypassing (no pore exclusion / Treg) with phi_vic_kill quality multiplier</body>
        </notes>
      </parameter>
      <parameter id="mw54d197f1_9965_4387_aa44_025c1ab6303a" name="CD8_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total CD8 T cells in V_T (effector + terminal-exhausted + progenitor-exhausted + egressed vicinity effector). Aggregate alias for total-CD8 observables.</body>
        </notes>
      </parameter>
      <parameter id="mwd5463e69_a4bc_43cc_82cf_deae151d8bec" name="nucleated_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All nucleated cells in V_T (cancer + immune + CAFs). Used as the denominator for _pct_ calibration targets matching mIHC &quot;% of all nucleated cells&quot; measurements.</body>
        </notes>
      </parameter>
      <parameter id="mwd4299f53_227c_4e67_9d29_9ed7f142760b" name="CD8_exh_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Exhausted CD8 T cells in V_T (terminal + progenitor-exhausted). Excludes the egressed vicinity effector CD8_vic.</body>
        </notes>
      </parameter>
      <parameter id="mwabd79b5d_5341_465b_a685_c8361e428357" name="Th_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Conventional CD4 helper T cells in V_T (naive/effector + exhausted), excluding Treg.</body>
        </notes>
      </parameter>
      <parameter id="mwa236b339_d2f8_4dd1_9f4a_aeac403d64a9" name="CD4_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All CD4 T cells in V_T (conventional helper + Treg).</body>
        </notes>
      </parameter>
      <parameter id="mw47800dfd_0910_4574_9ca7_4aaa98e56489" name="Tcell_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All T cells in V_T (CD8 + CD4), the model side of a pan-CD3 stain.</body>
        </notes>
      </parameter>
      <parameter id="mw47d252fc_d80d_434f_be97_583f498ff437" name="Mac_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumour-associated macrophages in V_T (M1-like + M2-like).</body>
        </notes>
      </parameter>
      <parameter id="mwcbf34ff2_1136_4b6e_b584_e5625b234f92" name="DC_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All dendritic cells in V_T (immature + mature, cDC1 + cDC2).</body>
        </notes>
      </parameter>
      <parameter id="mw7afc8f92_0ab6_4473_a0ed_612b8f2aa2ca" name="mDC_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Mature dendritic cells in V_T (mcDC1 + mcDC2), the DC-LAMP+ subset.</body>
        </notes>
      </parameter>
      <parameter id="mwc497d9c8_b470_407e_ac00_66559e64b1d4" name="cDC1_lineage_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">cDC1 lineage in V_T at any maturation state (cDC1 + mcDC1).</body>
        </notes>
      </parameter>
      <parameter id="mwb1f3a974_7c10_4465_a9d6_ed9b9801baa6" name="cDC2_lineage_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">cDC2 lineage in V_T at any maturation state (cDC2 + mcDC2).</body>
        </notes>
      </parameter>
      <parameter id="mwf7e4bea8_dc61_4089_90a2_c8015a8063ff" name="immune_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All leukocytes in V_T (T cells + macrophages + MDSC + DC). Excludes cancer cells and CAFs, unlike nucleated_total_T.</body>
        </notes>
      </parameter>
      <parameter id="mw8ae6080d_77c3_4807_9768_fb484072210a" name="CD8_total_C" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Whole-repertoire CD8 T cells in V_C (per-clone naive pool scaled by div_CD8, plus the expanded antigen-specific clone).</body>
        </notes>
      </parameter>
      <parameter id="mwcdc44951_57c0_49e0_9d23_8d65387b4af9" name="CAF_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Activated cancer-associated fibroblasts in V_T (iCAF + myCAF + apCAF). Excludes quiescent qPSC.</body>
        </notes>
      </parameter>
    </listOfParameters>
