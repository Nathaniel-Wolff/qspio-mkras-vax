      <parameter id="mwc8babe0c_cd54_4d57_b990_f567edda132f" name="k_IL6_deg" value="16" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 degradation rate</body>
