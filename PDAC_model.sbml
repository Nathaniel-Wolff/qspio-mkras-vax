      <parameter id="mw9f8a0ce2_7a57_4d0f_be4c_69cd167ffba3" name="k_M1_pol" value="1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of M2 to M1 macrophage polarization </body>
        </notes>
      </parameter>
      <parameter id="mwb380985c_90f2_48a1_ba21_608b7a2ddbf1" name="IL10_50_M2" value="8" units="MWBUILTINPREFIX_pico_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal IL-10 level for M1 to M2 macrophage polarization (innate-myeloid STAT3 axis)</body>
        </notes>
      </parameter>
      <parameter id="mwc64702ba_9c97_4129_8d0e_65f3c8c0754a" name="IL10_50_APC" value="8" units="MWBUILTINPREFIX_pico_MWBUILTINUNIT_molarity" constant="true">
        <notes>
