      </parameter>
      <parameter id="mw2d83e469_9248_4c9f_8989_7975405f45a6" name="H_IL1_eff" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Effective IL-1 Hill function. TGFb antagonizes by increasing effective EC50 via IL-1R1 repression (saturating).</body>
        </notes>
      </parameter>
      <parameter id="mwa5ea0327_69ab_4cef_90d7_ca72e4fc3651" name="k_vas_myCAF_sec" value="0.002" units="MWDERIVEDUNIT_picogram__cell_day" constant="true">
        <notes>
