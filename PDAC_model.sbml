      <parameter id="mw643e805b_b36f_44b0_8fc5_b0939da4541e" name="vol_Mcell" value="4849.04826081585" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of a single macrophage cell </body>
        </notes>
      </parameter>
      <parameter id="mw030a4077_9f54_4d5a_9307_940adbbbd4cb" name="kon_CD47_SIRPa" value="0.0625" units="MWDERIVEDUNIT_1__micromolarity_minute_nanometer" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">kon of CD47-SIRPa binding </body>
        </notes>
