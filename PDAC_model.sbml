    <listOfRules>
      <assignmentRule variable="mw3a17f8cf_8f20_4ff1_9ce0_fd1cd07339d7">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <plus/>
            <ci> mw9665b62b_e926_457e_b9be_8db812605bdf </ci>
            <apply>
              <divide/>
              <apply>
                <plus/>
                <apply>
                  <times/>
                  <apply>
