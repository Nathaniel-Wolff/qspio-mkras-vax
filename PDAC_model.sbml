          <body xmlns="http://www.w3.org/1999/xhtml">Rate of M2 to M1 macrophage polarization </body>
        </notes>
      </parameter>
      <parameter id="mw61b39e70_f36c_4eb2_802d_7c6d816efbb9" name="IL10_50_M2" value="8" units="MWBUILTINPREFIX_pico_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal IL-10 level for M1 to M2 macrophage polarization (innate-myeloid STAT3 axis)</body>
        </notes>
      </parameter>
      <parameter id="mw9dcdf1af_88fe_47c2_8cf1_4c7e0c882cd3" name="IL10_50_APC" value="8" units="MWBUILTINPREFIX_pico_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal IL-10 level for DC maturation suppression (cDC1/cDC2)</body>
        </notes>
      </parameter>
      <parameter id="mw7314f29e_22da_4cda_b198_4cd94ad76623" name="IL10_50_Treg" value="8" units="MWBUILTINPREFIX_pico_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal IL-10 level for amplifying Treg-mediated CD8 exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwd1af0c8c_efa0_4936_82d7_da475bc8066d" name="IL12_50" value="15" units="MWBUILTINPREFIX_pico_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal IL-12 level for M2 to M1 macrophage polarization </body>
        </notes>
      </parameter>
      <parameter id="mwaca904cc_1823_4cc2_8802_ae1233fc1876" name="k_IFNg_response" value="0.2" units="MWDERIVEDUNIT_1__picomolarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Linear slope of IFNg-driven M2 to M1 polarization in the sub-saturating regime (replaces IFNg_50 Hill)</body>
        </notes>
      </parameter>
      <parameter id="mw9db335e5_3bfc_49ac_b6b5_7fc5fcdecd02" name="k_M1_phago" value="0.33" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of M1 macrophage-mediated killing of cancer cell </body>
        </notes>
