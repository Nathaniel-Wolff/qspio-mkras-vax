      <parameter id="mwe1dfce68_3347_4cd6_a014_ac9a411b98f7" name="IL1_ratio" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Dimensionless IL-1 ratio: IL1 / effective EC50</body>
