      <parameter id="mwc2e8e877_b4eb_48fa_81ae_b7ac9c6205b4" name="k_apCAF_Treg" value="0.03" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max Th-&gt;Treg conversion rate via apCAF</body>
