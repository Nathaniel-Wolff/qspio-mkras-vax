                </apply>
                <apply>
                  <plus/>
                  <ci> mwd9447176_c5c0_4964_93cc_67b1b3b6b0a6 </ci>
                  <ci> mw3716b9d9_5547_4b74_a68b_6531af15eb61 </ci>
                  <ci> mw5450608d_d047_457a_a5aa_1b0718ef1f85 </ci>
                </apply>
