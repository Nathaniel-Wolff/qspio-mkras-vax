      <parameter id="mw9e3b9fd7_9e0d_4cfa_81fe_f5e18ceee516" name="k_IL1_sec" value="1e-12" units="MWDERIVEDUNIT_nanomole__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-1alpha secretion rate by cancer cells</body>
