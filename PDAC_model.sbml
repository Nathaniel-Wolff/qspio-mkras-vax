      <parameter id="mw17354e95_05b2_4d27_bc32_a91a0bddb99f" name="H_IL6_iCAF" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL-6 autocrine feedback on iCAF phenotype</body>
