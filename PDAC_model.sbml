        </notes>
      </parameter>
      <parameter id="mw27f4d265_a5cb_4d60_8794_e691d65ef5e6" name="vol_apCAFcell" value="2500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of apCAF</body>
        </notes>
      </parameter>
