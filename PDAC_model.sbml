      <parameter id="mw33bb0f27_4779_4806_8a28_13fb5a27eb82" name="k_P1_up_apCAF" value="1.44" units="MWDERIVEDUNIT_1__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen uptake rate by apCAFs</body>
