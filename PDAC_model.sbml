      <parameter id="mwb57ad661_c48c_433a_9d7b_9f09a30a562c" name="k_GMCSF_deg" value="5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF degradation/clearance rate (half-life ~3 hours)</body>
