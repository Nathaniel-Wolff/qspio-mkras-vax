        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF proliferation rate</body>
        </notes>
      </parameter>
      <parameter id="mw9fe6254e_f523_43ea_b55d_7371684a48d5" name="k_apCAF_prolif" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">apCAF proliferation rate (lower than iCAF/myCAF)</body>
        </notes>
      </parameter>
      <parameter id="mwe6e6a8e5_f61d_437b_aebf_c1f28b7111dc" name="f_stroma_max" value="2.43" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF:cancer ratio — total carrying-capacity budget partitioned across iCAF/myCAF/apCAF</body>
        </notes>
      </parameter>
      <parameter id="mwe64552b2_2107_452a_9c22_8eee9d3d3d91" name="f_apCAF_of_total" value="0.1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">apCAF share of the total CAF carrying capacity. Default 0.1 from Elyada 2019 Fig 5D (apCAFs ~10% of PDAC CAFs). Free parameter in the stick-breaking simplex parameterization (paired with f_iCAF_of_non_apCAF).</body>
        </notes>
      </parameter>
      <parameter id="mw69145124_43d9_43ba_b7e7_a8a998476cbd" name="f_iCAF_of_non_apCAF" value="0.222" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF share of the non-apCAF CAF mass (stick-breaking second step). Default 0.222 from Elyada 2019 Fig 5D — myCAF 0.7 + iCAF 0.2 of total → iCAF/(iCAF+myCAF) = 0.2/0.9 = 0.222. Free parameter in the stick-breaking simplex parameterization (paired with f_apCAF_of_total).</body>
        </notes>
      </parameter>
      <parameter id="mw908e874a_bded_4fe3_8821_fc5aed9a69fc" name="k_col_myCAF_sec" value="5e-08" units="MWDERIVEDUNIT_milligram__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw85179245_afd0_47cf_ada1_eb5cc8c269cb" name="f_col_basal" value="0.15" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Basal fraction of collagen secretion (TGFb-independent)</body>
        </notes>
      </parameter>
      <parameter id="mwff13729b_4fa6_47e6_81cf_07904aeb9f02" name="TGFb_50_CAF_act" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for CAF activation and interconversion</body>
        </notes>
      </parameter>
      <parameter id="mw7a241d66_4b8c_40c6_8d17_a1c66fa5c208" name="TGFb_50_col_sec" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for collagen secretion</body>
        </notes>
      </parameter>
      <parameter id="mw1aecf667_1997_4131_a4f7_47c77b7e4987" name="k_col_deg" value="0.007" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Constitutive collagen degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mwfa63f686_1ba9_4bad_81af_30482813a03e" name="k_MMP_M2" value="1e-08" units="MWDERIVEDUNIT_milliliter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">M2 macrophage MMP-mediated collagen degradation</body>
        </notes>
      </parameter>
      <parameter id="mw2339a86d_4708_47b1_b607_d2686b636538" name="phi_cross_50" value="0.03" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction at 50% MMP-susceptibility (LOX-crosslinking shield)</body>
        </notes>
      </parameter>
      <parameter id="mwa2a1ee81_598e_40fa_9f79_fdf5b8946a14" name="f_nascent" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Fraction of collagen susceptible to M2 MMP degradation (non-crosslinked)</body>
        </notes>
      </parameter>
      <parameter id="mw3c999aec_5808_43ee_a2ce_a053abf3a06b" name="rho_collagen" value="0.103" units="MWDERIVEDUNIT_gram__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen packing density (material constant)</body>
        </notes>
      </parameter>
      <parameter id="mw63f33c44_1787_4dd4_bbd8_e04f564774a2" name="phi_collagen" value="0.12" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction (0-1). Bare-volume normalized; primary input for all ECM Hill functions.</body>
        </notes>
      </parameter>
      <parameter id="mw45e175ce_d9ab_43fa_a9a7_9a266b34de88" name="k_qpsc_death" value="0.005" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of quiescent PSCs</body>
        </notes>
      </parameter>
      <parameter id="mw5fab2141_d1c8_418f_94a3_9444e64a81a3" name="k_iCAF_death" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwf36596da_259a_4fdb_bbc8_40da1c016f1f" name="k_myCAF_death" value="0.015" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwdc04a5ee_e158_49b4_8f5f_06b43f99d3c6" name="k_apCAF_death" value="0.03" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw104c56ee_865d_45a3_a62f_324e47adffeb" name="d_pore_ref" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference pore size in normal pancreas (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mw5551f628_9e7a_43ff_a366_0cc4d49baf3d" name="phi_col_ref" value="0.046" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction in normal pancreas (reference)</body>
        </notes>
      </parameter>
      <parameter id="mw0cb23e93_1051_434a_b094_6b51a732f710" name="d_crit_T" value="2.3" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for T cell migration arrest (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mwe0430c37_7224_4b7b_8853_75a932c04a47" name="d_crit_APC" value="2.1" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for APC migration arrest (podosome/MMP migration)</body>
        </notes>
      </parameter>
      <parameter id="mwb4d88530_5cb5_4b1d_9953_1a6d51696590" name="n_pore" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for pore-size exclusion sharpness</body>
        </notes>
      </parameter>
      <parameter id="mw8cad565f_9205_460c_999a_13abd5bffee9" name="d_pore" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore size between collagen fibers (decreases with density)</body>
        </notes>
      </parameter>
      <parameter id="mw9923ee9a_0bd8_416a_88ef_6d21fde841df" name="H_pore_T" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based T cell exclusion. 1=fully excluded, 0=free migration.</body>
        </notes>
      </parameter>
      <parameter id="mwab5b62c4_77b6_48ec_b03c_24a46d2da96c" name="H_pore_APC" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based APC exclusion. DCs more deformable than T cells.</body>
        </notes>
      </parameter>
      <parameter id="mw6f1702e3_e6a6_468d_8d9b_b0ce0ab0e7bb" name="E_ref" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference stiffness at phi_col_ref (~1 kPa, dimensionless)</body>
        </notes>
      </parameter>
      <parameter id="mw2db117c8_4048_4e94_94a6_4426e9aba5ca" name="n_stiff" value="1.8" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Power law exponent for stiffness-collagen relationship</body>
        </notes>
      </parameter>
      <parameter id="mw230c62cf_b2fb_4984_9972_8a4723d9a6f3" name="E_50_Texh" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw6ac68714_9713_4803_8145_d7a584e3ffa7" name="n_Texh" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw8bbee584_bf9c_481f_8b49_469d3daeadf5" name="E_50_fib" value="5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for fibroblast mechanotransduction</body>
        </notes>
      </parameter>
      <parameter id="mwc1cd425d_f477_442b_8930_9481b8cda168" name="n_fib" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated fibroblast activation</body>
        </notes>
      </parameter>
      <parameter id="mw833b0abd_4567_4e7e_8761_c12c85c0ddd9" name="stiffness" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tissue stiffness (kPa-scaled, dimensionless). Power law of collagen density.</body>
        </notes>
      </parameter>
      <parameter id="mwec962c97_6856_478c_9d9a_c2f43e4983e8" name="H_stiff_Texh" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated T cell exhaustion (chronic mechanosensing, PD-L1)</body>
        </notes>
      </parameter>
      <parameter id="mw8a43370d_528a_4b8f_8060_c646f6e5e118" name="H_stiff_fib" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated fibroblast activation (YAP/TAZ mechanotransduction)</body>
        </notes>
      </parameter>
      <parameter id="mw4864ba59_72c8_47da_89ee_af741adf86b3" name="phi_col_50_Kmax" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">phi_collagen for 50% carrying capacity reduction. &gt;1 = ECM barrier never reaches half-max, consistent with stroma-depletion worsening PDAC (Rhim 2014, Ozdemir 2014).</body>
        </notes>
      </parameter>
      <parameter id="mwe9518ffe_d7e5_463f_98b2_5651cf6bf255" name="phi_col_max" value="0.5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Physical packing ceiling for collagen volume fraction (logistic secretion saturation). ~0.5 = peak fibrillar collagen packing in dense PDAC stroma (placeholder pending primary-source anchor).</body>
        </notes>
      </parameter>
      <parameter id="mw8a560027_87fd_42c2_ab30_5f6da17c7c8f" name="K_stiff_niche" value="100000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF population sustained by stiff ECM alone (mechanotransduction niche via YAP/TAZ). Allows fibrotic scar persistence post-therapy.</body>
        </notes>
      </parameter>
      <parameter id="mw9ad4d1e9_d4ec_4c00_9415_b6941f7089be" name="k_stroma_support" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Aggregate stromal contribution scale (global multiplier on subtype-weighted CAF sum in C_max). Constrained by Xu 2010 + Hwang 2008 orthotopic dose-response submodel targets.</body>
        </notes>
      </parameter>
      <parameter id="mw35853a87_b1f2_4131_8b30_db534d862614" name="k_stroma_myCAF" value="1.4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-myCAF contribution to cancer C_max. myCAFs build PDAC desmoplasia (collagen/CXCL12/VEGF) — dominant structural CAF subtype (Elyada 2019; Dominguez 2020).</body>
        </notes>
      </parameter>
      <parameter id="mw480b8bd7_8f44_4de1_9e5d_302cbadf1a7d" name="k_stroma_iCAF" value="0.28" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-iCAF contribution to cancer C_max. iCAFs are inflammatory secretors (IL-6/CXCL12), low αSMA, located distally from tumor — minimal structural carrying-capacity role (Elyada 2019, Öhlund 2017).</body>
        </notes>
      </parameter>
      <parameter id="mw9fb22989_fe3d_4baf_8b2c_8591ab5e7523" name="k_stroma_apCAF" value="0.07" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-apCAF contribution to cancer C_max. apCAFs are rare (&lt;5% of CAFs) MHC-II+ tolerogenic antigen-presenters — predominantly immunomodulatory (induce Treg expansion in antigen-specific manner), not structural (Elyada 2019, Huang 2022 Cancer Cell).</body>
        </notes>
      </parameter>
      <parameter id="mw6ac15bb1_e6b7_484d_aac4_ae394fb12047" name="C_cap0" value="1700000000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Baseline C-independent carrying-capacity floor (cells): parenchymal volume the lesion occupies pre-desmoplasia. UN-ANCHORED fitted structural handle (derivedFrom={}); value 1.7e9 is calibrated as the tumor_fold handle coupled with k_C1_growth~0.008, NOT a literature value. Candidate future submodel anchor: accessible parenchymal/lobular volume / vol_cell (queued in reconciliation_targets.csv) -- but GitHub #229 (V_T&lt;-&gt;C_max unification) would DERIVE and dissolve it. Default 0 recovers prior stroma+vascular-only C_max exactly.</body>
        </notes>
      </parameter>
      <parameter id="mw9954ba2e_8381_466c_af54_51c836c24c16" name="vol_qPSCcell" value="1500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of quiescent PSC</body>
        </notes>
      </parameter>
      <parameter id="mw143681c5_ecb9_4ea7_a809_d5ab7a56ee72" name="vol_iCAFcell" value="2000" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of iCAF</body>
        </notes>
      </parameter>
      <parameter id="mw6dcac1ff_ecd2_4b58_8f91_08ed7499e670" name="vol_myCAFcell" value="3500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of myCAF</body>
        </notes>
      </parameter>
      <parameter id="mw3db2d7b0_cab1_463b_8db9_a7c6435de684" name="vol_apCAFcell" value="2500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of apCAF</body>
        </notes>
      </parameter>
      <parameter id="mweb690f20_85cc_4550_a0b2_65c13fe0821d" name="k_CXCL12_sec_iCAF" value="1e-10" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 secretion rate by iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwed4ca873_57d3_4ad1_bfd7_3e12eb7cb844" name="k_CXCL12_deg" value="2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw7bdb29c4_c1b1_48a9_a3d2_2ee8d62e80c1" name="CXCL12_50_Texcl" value="8" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for CXCL12-mediated T cell exclusion</body>
        </notes>
      </parameter>
      <parameter id="mw7a49bd3a_d199_494a_86b5_6730634e5000" name="k_IL6_sec_iCAF" value="1.10362194189464e-09" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Effective iCAF-scaled IL-6 source rate</body>
        </notes>
      </parameter>
      <parameter id="mwf86f0988_e36f_429b_960e_d51af78a41f6" name="k_IL6_deg" value="16" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw20c0be4f_ecbc_4e54_97f0_7cabd3e03733" name="IL6_50_MDSC" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 enhancement of MDSC recruitment</body>
        </notes>
      </parameter>
      <parameter id="mw67f8bac4_1dd8_4f8e_9d68_c83631488539" name="IL6_50_M2" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 promotion of M2 polarization</body>
        </notes>
      </parameter>
      <parameter id="mw9e3a8124_6f54_4e9e_8074_5fe3ee05e9c5" name="IL6_50_iCAF" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 autocrine feedback promoting iCAF phenotype</body>
        </notes>
      </parameter>
      <parameter id="mw4b90f777_d862_4bd3_9215_794e9df596ad" name="f_IL6_iCAF" value="3" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Fold-enhancement of iCAF formation by IL-6 feedback</body>
        </notes>
      </parameter>
      <parameter id="mw1788bfd0_21ba_40fc_95f4_29b3215b021a" name="H_IL6_iCAF" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL-6 autocrine feedback on iCAF phenotype</body>
        </notes>
      </parameter>
      <parameter id="mw35d3e005_cc5e_4145_a8b5_7af72719d1ef" name="k_IL1_sec" value="1e-12" units="MWDERIVEDUNIT_nanomole__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-1alpha secretion rate by cancer cells</body>
        </notes>
      </parameter>
      <parameter id="mw7a8b1d48_129f_468a_9bf2_15f9673ade9e" name="k_IL1_deg" value="6.93" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-1alpha degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw7fd59fe0_5a97_44a9_a221_68203d18e290" name="IL1_50" value="0.01" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Basal EC50 for IL-1-driven iCAF formation</body>
        </notes>
      </parameter>
      <parameter id="mwe0501c6e_be9e_4615_99cb_a0f7ad5384a2" name="n_IL1" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for IL-1-driven iCAF formation</body>
        </notes>
      </parameter>
      <parameter id="mwe8c8cdb6_a688_426c_906a_698d5134510e" name="TGFb_50_IL1R1" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for IL-1R1 downregulation</body>
        </notes>
      </parameter>
      <parameter id="mw717f3e04_0bba_4837_8851_e378a653fb2f" name="Emax_IL1R1" value="5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max fold-shift of IL-1 EC50 by TGFb-driven IL-1R1 repression</body>
        </notes>
      </parameter>
      <parameter id="mw0e909e50_be6d_437c_a836_53c50f98301c" name="IL1_ratio" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Dimensionless IL-1 ratio: IL1 / effective EC50</body>
        </notes>
      </parameter>
      <parameter id="mw8eb1c7f7_e613_4606_ab33_fd80c67972b8" name="H_IL1_eff" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Effective IL-1 Hill function. TGFb antagonizes by increasing effective EC50 via IL-1R1 repression (saturating).</body>
        </notes>
      </parameter>
      <parameter id="mwa9ec8229_11c3_4b86_8a82_dad102639870" name="k_vas_myCAF_sec" value="0.002" units="MWDERIVEDUNIT_picogram__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwb00090fa_b6f5_43ef_9d3f_f0c85cc23626" name="k_apCAF_iTreg" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Effective antigen-specific induced-Treg rate via apCAF presentation</body>
        </notes>
      </parameter>
      <parameter id="mwdc07ac44_7097_4e2c_a39b_50f697889ab6" name="P1_50_apCAF" value="1e-09" units="MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for antigen-dependent Treg induction by apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw21ecd149_6047_4674_8001_1676eefec3c2" name="aPSC_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total activated PSC count (iCAF+myCAF+apCAF). Backward compatibility for test statistics.</body>
        </notes>
      </parameter>
      <parameter id="mw9df251b0_00f1_443a_a6bc_3a6b1d4d43f7" name="k_TGFb_sec_myCAF" value="2e-10" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGF-β secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwe813ca22_f00f_48f7_90d3_fcfd874307e1" name="k_CXCL12_sec_cancer" value="5e-11" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 secretion rate by tumor cells</body>
        </notes>
      </parameter>
      <parameter id="mw8fcc70a9_0ca2_4a27_99e7_1d4035ebeda3" name="H_apCAF_pMHCII" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Quasi-steady antigen-presentation gate for apCAF MHC-II-dependent Treg induction</body>
        </notes>
      </parameter>
      <parameter id="mw796b7b18_1c41_4b38_9147_3ba8e90b7be9" name="k_GVAX_clearance" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GVAX cell clearance rate from tumor</body>
        </notes>
      </parameter>
      <parameter id="mw4fc87414_1597_46b4_ac20_19996bcc9953" name="V_ID_volume" value="0.0001" units="MWBUILTINUNIT_liter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of intradermal injection site (~0.1 mL)</body>
        </notes>
      </parameter>
      <parameter id="mwf22f4325_2312_4eb8_a2a6_c65780d3c1eb" name="k_GMCSF_prod" value="1e-08" units="MWDERIVEDUNIT_nanomolarity__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF production rate per GVAX cell per day</body>
        </notes>
      </parameter>
      <parameter id="mw7e3a9098_c811_42e2_90fd_d4c5a69c38c7" name="k_GMCSF_deg" value="5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF degradation/clearance rate (half-life ~3 hours)</body>
        </notes>
      </parameter>
      <parameter id="mw2684d9f5_4e1a_4a83_8441_97610f70a187" name="k_APC_recruit_ID" value="100000" units="MWDERIVEDUNIT_cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC recruitment rate to intradermal injection site</body>
        </notes>
      </parameter>
      <parameter id="mw52daa83f_0926_4d28_999c_4427195fc24e" name="EC50_GMCSF" value="0.00294005042817446" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for GM-CSF-mediated APC recruitment and maturation</body>
        </notes>
      </parameter>
      <parameter id="mw19ad857d_aa6c_44a0_92b3_c199aef94a36" name="k_APC_mature_ID" value="2.72805986290677" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC maturation rate at injection site</body>
        </notes>
      </parameter>
      <parameter id="mw18125234_cc7d_44f9_a206_e1fe6b8c500e" name="k_APC_mig_ID_LN" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC migration rate from injection site to lymph nodes</body>
        </notes>
      </parameter>
      <parameter id="mw11e4abf5_6057_4534_bd0a_c0cca1c460be" name="k_APC_death_ID" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">APC death rate at injection site</body>
        </notes>
      </parameter>
      <parameter id="mwd30cbf2c_b7a4_49d1_869a_7296a8c4ca85" name="sigma_P1_per_mAPC" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen consumed per APC maturation event at injection site</body>
        </notes>
      </parameter>
      <parameter id="mwf9ad75e9_1450_41b6_a796_b49e84187ece" name="EC50_P1_mature" value="0.1" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for antigen-dependent APC maturation. Lowered from 10 nM to 0.1 nM on 2026-04-21 (Fix 3): with the 10 nM value, V_ID.P1_GVAX (~0.009 nM steady state) produced a Hill factor of ~0.0009 in J_mature_ID, so GVAX-derived antigen was never a meaningful contributor to APC maturation — maturation proceeded almost entirely via the GMCSF + baseline APC terms. 0.1 nM is an estimated value in the nanomolar-affinity range typical of peptide/antigen-receptor interactions; not anchored to a specific primary source. Candidate for submodel-target extraction.</body>
        </notes>
      </parameter>
      <parameter id="mw69c74f97_bf20_4d11_90be_0befe29a54ad" name="K_APC_ID" value="1000000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mw52baa2e7_cfc1_4be6_9229_4d096ffaaa1e" name="k_APC_recruit0" value="100" units="MWDERIVEDUNIT_cell__day" constant="true"/>
      <parameter id="mw987b7c14_eceb_420a_8833_4aa5cfb6dca9" name="k_mAPC_death_ID" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mwf90f7491_5524_4ef3_a904_90854be1dc78" name="y_Ag_per_cell" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true"/>
      <parameter id="mwf99bc1d8_191b_4ada_a0af_b1136c5baf32" name="k_P1_deg_ID" value="10" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mw6c253d6c_beff_4530_a885_945306552d97" name="K_APC_mig" value="100000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mw9f463229_e3dc_4805_bbc8_28fd28e0e5a6" name="k_cDC1_Ag_transfer" value="1e-07" units="MWDERIVEDUNIT_1__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen-transfer rate constant: migratory mcDC2 -&gt; resident cDC1 cross-licensing (Ferris 2022 PMID: 35648641; Mueller 2017 Eur J Immunol)</body>
        </notes>
      </parameter>
      <parameter id="mw9f97e0b2_2b7a_4bf7_b6de_9b82199785e3" name="k_GVAX_present" value="14.4" units="MWDERIVEDUNIT_1__day__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Vaccine-antigen presentation-uptake rate into the shared endosomal pMHC pool; parallel to tumor k_up=14.4 (audit consensus #2, GVAX-&gt;H_P1 coupling); placeholder centered at k_up, SBI-varied, submodel anchor pending</body>
        </notes>
      </parameter>
      <parameter id="mwe9a67b03_337e_4525_9cd1_1f12919620e2" name="H_GMCSF_ID" value="0" units="dimensionless" constant="false"/>
      <parameter id="mwf7b7daea_931f_4820_aff9_dd50c3020879" name="HMGB1_50_ID" value="10000000" units="MWDERIVEDUNIT_cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max death FLUX (cell/day) for HMGB1 (DAMP)-mediated APC maturation at the GVAX injection depot; anchored to the depot operating death flux (~5e7 cell/day peak) so H_HMGB1_ID sits responsive. Literature-anchor route deferred (HMGB1_50_ID = EC50*k_deg*V_ID/q_release).</body>
        </notes>
      </parameter>
      <parameter id="mwfd986ee7_6d64_4bf8_b8cf_c5ec369081d5" name="H_HMGB1_ID" value="0" units="dimensionless" constant="false"/>
      <parameter id="mwd717db32_b066_4de3_a0fe_575be3e94aad" name="J_mature_ID" value="0" units="MWDERIVEDUNIT_cell__day" constant="false"/>
      <parameter id="mwd7642147_c672_4314_8fa4_372c9164c92f" name="f_epitope_spread" value="4.89897948556636" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Shared effective fold-broadening of tumor-specific CD4 and CD8 repertoires under saturating GVAX antigen (qualitatively anchored to Thomas 2004 PMID 15289501; geometric-mean initial value; estimated and requires reduced-model refit).</body>
        </notes>
      </parameter>
      <parameter id="mweb0b9db2_5bc4_4f83_acb3_3b6230775237" name="H_P1_spread" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Vaccine-antigen Hill gating epitope-spreading clonal recruitment (Path A); 0 at diagnosis</body>
        </notes>
      </parameter>
      <parameter id="mwcd3d35d7_907e_41b1_994e_83afd4c57aad" name="k_CD8_T_vac_pro" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GVAX-vaccine-gated in-situ tumor CD8 proliferation increment (Path C). Anchored to f*k_CD8_T_pro (f~0.6): the vaccine-differential increment is a bounded fraction of the Blessin-anchored constitutive in-situ rate (k_CD8_T_pro=0.079/day). H_P1_spread-gated (zero without vaccine), saturating in V_T.CD8 density. Retained in gvax_module after the C13 TLA/urelumab cut. Prior sigma 0.7 (was 1.5 placeholder). See notes/calibration/vpop_thexh_cd8vac_anchoring_2026-07-23.md.</body>
        </notes>
      </parameter>
      <parameter id="mw64146674_c0b4_44c8_baac_340303457e0d" name="k_Cy_clear" value="2.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide clearance rate</body>
        </notes>
      </parameter>
      <parameter id="mw7b70df53_1c23_420b_b0bb_7ce900cbce5f" name="k_Cy_Treg_deplete" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Maximum Treg depletion rate by cyclophosphamide</body>
        </notes>
      </parameter>
      <parameter id="mwe0ba6810_3b19_475d_82ce_5aadeffd0d11" name="Cy_50_Treg" value="50" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_gram" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide concentration for 50% Treg depletion</body>
        </notes>
      </parameter>
      <parameter id="mwa4730091_c7b6_4b2e_991f_f2194c58729b" name="k_Cy_eff_decay" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Decay rate of the cyclophosphamide durable PD effect compartment (sets Treg-suppression duration)</body>
        </notes>
      </parameter>
      <parameter id="mw171e92ec_b51d_4ee9_b0c4_c348db0f7c4b" name="Emax_Cy_Treg" value="0.8" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Maximum fractional suppression of tumor-Treg proliferation by the Cy effect compartment</body>
        </notes>
      </parameter>
      <parameter id="mwf9db8539_999d_4f52_b6e3_21d95402107b" name="k_Cy_on" value="10" units="MWDERIVEDUNIT_milligram__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Build rate of the cyclophosphamide effect compartment from drug exposure (structural; weakly identifiable, fixed)</body>
        </notes>
      </parameter>
      <parameter id="mw8d972365_0a17_4335_a19b_d0127402c8b0" name="Cy_eff_50" value="1" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_gram" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-saturation of the Cy effect compartment on tumor-Treg proliferation (structural; weakly identifiable, fixed)</body>
        </notes>
      </parameter>
      <parameter id="mw16486767_830d_466b_8d18_da9e75b5be19" name="CD8_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total CD8 T cells in V_T (effector + terminal-exhausted + progenitor-exhausted). Aggregate alias for total-CD8 observables.</body>
        </notes>
      </parameter>
      <parameter id="mw3b93c516_3747_43eb_a65a_21b1921e22ea" name="nucleated_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All nucleated cells in V_T (cancer + immune + CAFs). Used as the denominator for _pct_ calibration targets matching mIHC &quot;% of all nucleated cells&quot; measurements.</body>
        </notes>
      </parameter>
      <parameter id="mw6671f1bf_2b28_4e66_a614_64c24f6c1453" name="CD8_exh_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Exhausted CD8 T cells in V_T (terminal + progenitor-exhausted).</body>
        </notes>
      </parameter>
      <parameter id="mw2b6c1566_fd3c_4815_b7ce_12e3b643ca4a" name="Th_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Conventional CD4 helper T cells in V_T (naive/effector + exhausted), excluding Treg.</body>
        </notes>
      </parameter>
      <parameter id="mw9c2a1af4_6a7d_4e49_bef1_a98ced1efce2" name="CD4_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All CD4 T cells in V_T (conventional helper + Treg).</body>
        </notes>
      </parameter>
      <parameter id="mw61d4ad0d_44c0_4f3e_a010_b203ef66c872" name="Tcell_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All T cells in V_T (CD8 + CD4), the model side of a pan-CD3 stain.</body>
        </notes>
      </parameter>
      <parameter id="mw49e89a54_09c5_46d3_9fbb_6a951c9201b3" name="Mac_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumour-associated macrophages in V_T (M1-like + M2-like).</body>
        </notes>
      </parameter>
      <parameter id="mw68b70203_9dfc_452f_b3f1_fa0ce3e93068" name="DC_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All dendritic cells in V_T (immature + mature, cDC1 + cDC2).</body>
        </notes>
      </parameter>
      <parameter id="mwea921647_8ab3_4d83_8196_f54676f9b324" name="mDC_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Mature dendritic cells in V_T (mcDC1 + mcDC2), the DC-LAMP+ subset.</body>
        </notes>
      </parameter>
      <parameter id="mw470a5566_66f5_4ccc_abd9_82044cb9dc0f" name="cDC1_lineage_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">cDC1 lineage in V_T at any maturation state (cDC1 + mcDC1).</body>
        </notes>
      </parameter>
      <parameter id="mw87a9e701_2bfc_4063_a043_5bbdd142ba3d" name="cDC2_lineage_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">cDC2 lineage in V_T at any maturation state (cDC2 + mcDC2).</body>
        </notes>
      </parameter>
      <parameter id="mw063ff0fa_66fd_487d_8d94_9de7afd5117a" name="immune_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">All leukocytes in V_T (T cells + macrophages + MDSC + DC). Excludes cancer cells and CAFs, unlike nucleated_total_T.</body>
        </notes>
      </parameter>
      <parameter id="mw0ef35547_3817_4885_ac0a_bd1dcc316f63" name="CD8_total_C" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Whole-repertoire CD8 T cells in V_C (per-clone naive pool scaled by div_CD8, plus the expanded antigen-specific clone).</body>
        </notes>
      </parameter>
      <parameter id="mwb8f4f145_2c44_4626_946f_a68ab0655f1e" name="CAF_total_T" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Activated cancer-associated fibroblasts in V_T (iCAF + myCAF + apCAF). Excludes quiescent qPSC.</body>
        </notes>
      </parameter>
    </listOfParameters>
