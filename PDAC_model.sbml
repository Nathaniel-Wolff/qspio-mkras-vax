      <species id="mw94efb055_75e7_4981_b072_d5f1200a542e" name="IL12" compartment="mw9336cea3_584b_4091_bc40_d026d9f813bb" initialConcentration="0" substanceUnits="MWDERIVEDUNIT_nanomolarity_milliliter" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false">
