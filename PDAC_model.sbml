    <listOfParameters>
      <parameter id="mwf6449949_fc01_452b_be52_f9f9120d2b4e" name="k_cell_clear" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of dead cell clearance from tumour compartment</body>
        </notes>
      </parameter>
      <parameter id="mw706fa879_b795_40c7_94de_3488fb2178aa" name="cell" value="1" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">unit parameter for calculation</body>
        </notes>
      </parameter>
      <parameter id="mwa7accf6e_6d92_4d80_b53d_6d28af1f0a1f" name="day" value="1" units="MWBUILTINUNIT_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">unit parameter for calculation</body>
        </notes>
      </parameter>
      <parameter id="mw55b06dd5_c202_4d31_84b5_e3e28707fcef" name="D_cell" value="17" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average diameter of cancer cell</body>
        </notes>
      </parameter>
      <parameter id="mw2478f031_9ea4_4105_8e56_aa5863034428" name="vol_cell" value="2572.44078451444" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average volume of cancer cell</body>
        </notes>
      </parameter>
      <parameter id="mw8936ad0b_9cd3_4cb8_ad14_4f2b8e0bed67" name="vol_Tcell" value="175.015709799539" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average volume of T cells</body>
        </notes>
      </parameter>
      <parameter id="mw9ea99d2d_a777_48c8_8524_6051abafdada" name="Ve_T" value="0.37" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Intracellular fraction of the tumor</body>
        </notes>
      </parameter>
      <parameter id="mwfc42f300_bca4_4e3e_aa45_deb32224bdb8" name="V_Tmin" value="1e-06" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_liter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Minimum tumor compartment volume (cancer-free baseline)</body>
        </notes>
      </parameter>
      <parameter id="mw2f3f53f3_70e2_4e48_ba88_6c1c3eb5ac3e" name="C_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of cancer cells</body>
        </notes>
      </parameter>
      <parameter id="mwc47daa60_03bd_4234_aa66_8a2777dbd9b4" name="T_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of activated T cells in tumor</body>
        </notes>
      </parameter>
      <parameter id="mw33076329_97a3_4f3d_ad6e_c69c9fe560f6" name="T_total_LN" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of activated T cells in TDLNs</body>
        </notes>
      </parameter>
      <parameter id="mw68f214bc_aa30_4b79_b562_91918b4b155a" name="R_Tcell" value="1" units="MWDERIVEDUNIT_cell__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of cancer cell death</body>
        </notes>
      </parameter>
      <parameter id="mw94e1c0b6_e2bc_4dcd_a137_cf93bee74837" name="Tregs_" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of Tregs in tumor compartment (V_T.Treg)</body>
        </notes>
      </parameter>
      <parameter id="mwb310baf0_2dbd_4d1d_9986_b94fba982ea2" name="H_APC_Treg" value="0.5" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of cDC2 for Treg activation (shared nCD4 pool, self-antigen)</body>
        </notes>
      </parameter>
      <parameter id="mw174ef73c_035c_49f5_b2cd_62fc35aa3469" name="H_PD1_C1" value="0.9" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of PDL1 on chemotherapy-sensitive tumor cells for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw65739da9_ac43_4c4c_99fb_cc9714eea6e1" name="H_PD1_APC" value="0.9" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of PDL1 on APC for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwd37bad72_2eaa_4973_abc3_f7c83c81e2b5" name="H_CD28_C1" value="0.1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of CD28 on tumor cells</body>
        </notes>
      </parameter>
      <parameter id="mwb87c827d_5269_445d_b8e7_bc5305c9cb50" name="H_CD28_APC" value="0.1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of CD28 on APCs for T cell activation</body>
        </notes>
      </parameter>
      <parameter id="mw7921257b_5e08_4c56_aac3_2f2c2ceaf6a0" name="k_C1_growth" value="0.008" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cancer growth rate</body>
        </notes>
      </parameter>
      <parameter id="mwfb03db26_70b1_4d80_b747_56e9467b5cbf" name="k_C1_death" value="0.003" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cancer death rate</body>
        </notes>
      </parameter>
      <parameter id="mwec6c6d97_2169_42e6_9bbf_b5c4cb9eb63f" name="C_max" value="27000" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Aggregate tumor carrying capacity (Gompertzian denominator). Initialized = K_vasc here, then RE-DEFINED in fibroblast_module_enhanced to (C_cap0 + K_vasc + CAF stromal support) * collagen barrier.</body>
        </notes>
      </parameter>
      <parameter id="mwac60b073_1677_40b2_b2da_f09b4ed63008" name="k_C1_therapy" value="0" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Therapy-induced death rate</body>
        </notes>
      </parameter>
      <parameter id="mw56a10f86_56bb_4bc9_af94_30192c386e75" name="initial_tumour_diameter" value="3.2" units="MWBUILTINPREFIX_centi_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pre-treatment tumor diameter</body>
        </notes>
      </parameter>
      <parameter id="mwc0b721e2_97ae_4496_956c_5e7c16a3c4a8" name="K_initial" value="10300" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Initial tumor carrying capacity</body>
        </notes>
      </parameter>
      <parameter id="mwea83c7a4_51fb_4b89_bdb4_04d00cfd929c" name="k_vas_growth" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor vasculature growth rate</body>
        </notes>
      </parameter>
      <parameter id="mwd925a7d5_7ac5_410a_91be_7b178c096666" name="k_vas_decay" value="0.0001" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor vasculature inhibition rate</body>
        </notes>
      </parameter>
      <parameter id="mw92edfda1_1323_4d60_9124_741646b74b9a" name="vas_inhib_vol_scale" value="2.57e-06" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-cell tumor-volume scaling (cancer cell volume in mm^3 ~ 4/3*pi*(D_cell/2)^3*1e-9) for the Hahnfeldt 1999 V^(2/3) endogenous vascular-inhibition surface term (PMID 10519381).</body>
        </notes>
      </parameter>
      <parameter id="mwb3d7a164_e472_4fff_a156_61ed2a9fb85e" name="k_vas_Csec" value="0.1" units="MWDERIVEDUNIT_picogram__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor secretion rate</body>
        </notes>
      </parameter>
      <parameter id="mw598ab5ec_2652_4bb5_9e1b_da31cba42886" name="k_vas_deg" value="16.6" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw21dde89f_9630_4199_9999_0919f3d567d9" name="VEGF_50" value="2410" units="MWDERIVEDUNIT_picogram__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal angiogenic factor concentration for tumor capacity growth</body>
        </notes>
      </parameter>
      <parameter id="mw229cc592_edcd_4309_b95d_2c4f6f9cc8ea" name="div_Treg" value="1160000" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">T Cell Diversity </body>
