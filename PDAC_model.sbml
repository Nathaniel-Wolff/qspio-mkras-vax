            <apply>
              <times/>
              <ci> mw619e93dd_f17d_483d_83d3_1e9c128f85ac </ci>
              <ci> mwc005f261_7b85_4e9e_be4c_9e3725bb1176 </ci>
              <ci> mwe4408528_5623_4499_993d_99eaf9f959d6 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
