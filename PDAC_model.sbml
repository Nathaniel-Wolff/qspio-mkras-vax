    <listOfParameters>
      <parameter id="mw1e5d2f2c_2aa4_4654_b798_73dda442ba4f" name="k_cell_clear" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of dead cell clearance from tumour compartment</body>
        </notes>
      </parameter>
      <parameter id="mw7be726ff_903f_419d_b73d_8ed077f6519e" name="cell" value="1" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">unit parameter for calculation</body>
        </notes>
      </parameter>
      <parameter id="mw31099d62_5b9f_44ef_a6bb_af528f973510" name="day" value="1" units="MWBUILTINUNIT_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">unit parameter for calculation</body>
        </notes>
      </parameter>
      <parameter id="mw8e9060f1_dc9e_4aec_94fa_662e5fd9eb18" name="D_cell" value="17" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average diameter of cancer cell</body>
        </notes>
      </parameter>
      <parameter id="mw0539f6df_fa69_4195_962b_1adc7396c9d7" name="vol_cell" value="2572.44078451444" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average volume of cancer cell</body>
        </notes>
      </parameter>
      <parameter id="mw4d642964_b45d_4d29_8c05_acb61eb9a3ec" name="vol_Tcell" value="175.015709799539" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average volume of T cells</body>
        </notes>
      </parameter>
      <parameter id="mw69533b2a_74de_472e_a7f7_9013ebe484cd" name="Ve_T" value="0.37" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Intracellular fraction of the tumor</body>
        </notes>
      </parameter>
      <parameter id="mw234e5289_f952_4c4a_9bab_4585fc51260f" name="V_Tmin" value="1e-06" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_liter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Minimum tumor compartment volume (cancer-free baseline)</body>
        </notes>
      </parameter>
      <parameter id="mw51f12fda_49fc_4766_a490_d0c9f2b013e5" name="C_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of cancer cells</body>
        </notes>
      </parameter>
      <parameter id="mwfbb84968_c3df_41db_b9bc_2d1ca5df3a33" name="T_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of activated T cells in tumor</body>
        </notes>
      </parameter>
      <parameter id="mwe887d28f_87d5_4cea_86de_eda1960f1436" name="T_total_LN" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of activated T cells in TDLNs</body>
        </notes>
      </parameter>
      <parameter id="mwea901bf1_bf23_4ed1_928f_a008d6688857" name="R_Tcell" value="1" units="MWDERIVEDUNIT_cell__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of cancer cell death</body>
        </notes>
      </parameter>
      <parameter id="mwa8498bac_8dff_4555_a76d_7c2c7aa7d9d8" name="Tregs_" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of Tregs in tumor compartment (V_T.Treg)</body>
        </notes>
      </parameter>
      <parameter id="mwa70b339b_21dd_495b_8b1a_b5eb1c361f8a" name="H_APC_Treg" value="0.5" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of cDC2 for Treg activation (shared nCD4 pool, self-antigen)</body>
        </notes>
      </parameter>
      <parameter id="mwb13e6bdb_ac3c_48be_aa32_84d3154c7702" name="H_PD1_C1" value="0.9" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of PDL1 on chemotherapy-sensitive tumor cells for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw22772271_9f2f_448a_8969_85c11bb009ad" name="H_PD1_APC" value="0.9" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of PDL1 on APC for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw098a0f81_07af_4c5d_9d9e_d84a7063f8d9" name="H_CD28_C1" value="0.1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of CD28 on tumor cells</body>
        </notes>
      </parameter>
      <parameter id="mw9ee99048_8eda_428c_86a9_51fdf649eb06" name="H_CD28_APC" value="0.1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of CD28 on APCs for T cell activation</body>
        </notes>
      </parameter>
      <parameter id="mw21270a06_3ae2_4e09_afd1_06da4a762b28" name="k_C1_growth" value="0.008" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cancer growth rate</body>
        </notes>
      </parameter>
      <parameter id="mw07f838cc_3928_4598_a7a0_4ff82d2beab3" name="k_C1_death" value="0.003" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cancer death rate</body>
        </notes>
      </parameter>
      <parameter id="mwf1251d72_3e38_4ffa_9881_686f37649bb4" name="C_max" value="27000" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Aggregate tumor carrying capacity (Gompertzian denominator). Initialized = K_vasc here, then RE-DEFINED in fibroblast_module_enhanced to (C_cap0 + K_vasc + CAF stromal support) * collagen barrier.</body>
        </notes>
      </parameter>
      <parameter id="mw99a8dff0_bd5e_44a0_b4b0_d47ca41387aa" name="k_C1_therapy" value="0" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Therapy-induced death rate</body>
        </notes>
      </parameter>
      <parameter id="mwa70dced7_a2aa_4bff_a80f_c945bb090f21" name="initial_tumour_diameter" value="3.2" units="MWBUILTINPREFIX_centi_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pre-treatment tumor diameter</body>
        </notes>
      </parameter>
      <parameter id="mw2f0d0d91_73a8_4455_bdfe_9d2d3bafc708" name="K_initial" value="10300" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Initial tumor carrying capacity</body>
        </notes>
      </parameter>
      <parameter id="mw2df9070c_4e3b_4442_a479_148c5950a21d" name="k_vas_growth" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor vasculature growth rate</body>
        </notes>
      </parameter>
      <parameter id="mwf74bf5fc_2238_438d_badf_9060353e6aab" name="k_vas_decay" value="0.0001" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor vasculature inhibition rate</body>
        </notes>
      </parameter>
      <parameter id="mw20da6b51_f22a_4f46_84cc_d56c2fbad8c8" name="vas_inhib_vol_scale" value="2.57e-06" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-cell tumor-volume scaling (cancer cell volume in mm^3 ~ 4/3*pi*(D_cell/2)^3*1e-9) for the Hahnfeldt 1999 V^(2/3) endogenous vascular-inhibition surface term (PMID 10519381).</body>
        </notes>
      </parameter>
      <parameter id="mw255215cb_c13a_443a_a1c5_b2a2a08d02e4" name="k_vas_Csec" value="0.1" units="MWDERIVEDUNIT_picogram__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor secretion rate</body>
        </notes>
      </parameter>
      <parameter id="mwe3cd6a09_1dae_43a7_9883_67fe9327b8d7" name="k_vas_deg" value="16.6" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw4562365c_ccce_4be0_a0eb_50bb803b8137" name="VEGF_50" value="2410" units="MWDERIVEDUNIT_picogram__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal angiogenic factor concentration for tumor capacity growth</body>
        </notes>
      </parameter>
      <parameter id="mw462c65cf_4f66_489c_8194_0b56db92f98d" name="div_Treg" value="1160000" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">T Cell Diversity </body>
