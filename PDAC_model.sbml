      <species id="mw74de06d8_dfe8_4a36_81ba_c68a1721d9b9" name="IL10" compartment="mw6d681743_210d_45e7_b5cb_ea5176345395" initialConcentration="0" substanceUnits="MWDERIVEDUNIT_nanomolarity_milliliter" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false">
