        </notes>
      </species>
      <species id="mw5bcd9a6f_a477_4baf_a0d2_c8d957dbde80" name="CD8_TLA_act" compartment="mw17b20b77_5482_4e77_94bb_38244168aa38" initialAmount="0" substanceUnits="MWUSERUNIT_cell" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false">
        <notes>
