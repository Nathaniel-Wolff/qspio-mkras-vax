              <ci> mwcb569f0c_ab10_442f_b716_80878412d628 </ci>
              <ci> mw1ba5eee7_045a_46dc_895c_a93859356032 </ci>
              <ci> mw31d2dd3c_783c_4882_99cb_65a53b7ee5cb </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
