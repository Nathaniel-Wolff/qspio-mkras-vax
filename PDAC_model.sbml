        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of intradermal injection site (~0.1 mL)</body>
        </notes>
      </parameter>
      <parameter id="mwf5668284_10a1_4e5a_a60e_e04f9b03d521" name="k_GMCSF_prod" value="1e-08" units="MWDERIVEDUNIT_nanomolarity__cell__day" constant="true">
