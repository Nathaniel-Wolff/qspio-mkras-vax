    <listOfParameters>
      <parameter id="mw69f98b7b_ff10_493f_b5a6_156a57f4e0e8" name="k_cell_clear" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of dead cell clearance from tumour compartment</body>
        </notes>
      </parameter>
      <parameter id="mwf6bc774e_0a26_44fd_b742_e7ae9fee24d2" name="cell" value="1" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">unit parameter for calculation</body>
        </notes>
      </parameter>
      <parameter id="mw870e510d_b276_4dda_95f0_b9188c1c1824" name="day" value="1" units="MWBUILTINUNIT_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">unit parameter for calculation</body>
        </notes>
      </parameter>
      <parameter id="mw9ab14b53_a70e_4208_83ab_23cdb038ed9b" name="D_cell" value="17" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average diameter of cancer cell</body>
        </notes>
      </parameter>
      <parameter id="mw307ca9e2_cf94_4cc3_bf97_fbd889166824" name="vol_cell" value="2572.44078451444" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average volume of cancer cell</body>
        </notes>
      </parameter>
      <parameter id="mw232f1f46_8b4f_4035_bd4c_3e3b1bfdea7f" name="vol_Tcell" value="175.015709799539" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average volume of T cells</body>
        </notes>
      </parameter>
      <parameter id="mw459c3221_c86e_4b31_aa72_045ba99c9e9b" name="Ve_T" value="0.37" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Intracellular fraction of the tumor</body>
        </notes>
      </parameter>
      <parameter id="mwcf88250f_eb33_41d3_9ddc_4137a0355ddf" name="V_Tmin" value="1e-06" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_liter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Minimum tumor compartment volume (cancer-free baseline)</body>
        </notes>
      </parameter>
      <parameter id="mwd2389f27_ad61_4480_8941_a6edf9fb2f10" name="C_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of cancer cells</body>
        </notes>
      </parameter>
      <parameter id="mw57427105_11b2_435f_9874_64a804963ceb" name="T_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of activated T cells in tumor</body>
        </notes>
      </parameter>
      <parameter id="mwa80fba57_8033_427e_97ea_f38cbecaf3d0" name="T_total_LN" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of activated T cells in TDLNs</body>
        </notes>
      </parameter>
      <parameter id="mwac923b8a_6ece_4070_b39a_b747b9b0b1da" name="R_Tcell" value="1" units="MWDERIVEDUNIT_cell__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of cancer cell death</body>
        </notes>
      </parameter>
      <parameter id="mwa197b9c0_bac1_44e1_914d_b031e92835fb" name="Tregs_" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of Tregs in tumor compartment (V_T.Treg)</body>
        </notes>
      </parameter>
      <parameter id="mw214e5d34_37bb_409a_a2cb_9d28373ebd85" name="H_APC_Treg" value="0.5" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of cDC2 for Treg activation (shared nCD4 pool, self-antigen)</body>
        </notes>
      </parameter>
      <parameter id="mwa4ead546_b4f5_4182_af84_aed3ae8e8295" name="H_PD1_C1" value="0.9" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of PDL1 on chemotherapy-sensitive tumor cells for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw19c83ada_05c4_43a3_b923_f11e72166b8e" name="H_PD1_APC" value="0.9" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of PDL1 on APC for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwad0f2007_0df6_443e_aac2_45abd17bc3ab" name="H_CD28_C1" value="0.1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of CD28 on tumor cells</body>
        </notes>
      </parameter>
      <parameter id="mw57bb19e2_6e17_4eea_9f44_8e6c8db570d0" name="H_CD28_APC" value="0.1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of CD28 on APCs for T cell activation</body>
        </notes>
      </parameter>
      <parameter id="mw3107bda0_ec8f_4b7f_930b_5d19de85c7ba" name="k_C1_growth" value="0.008" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cancer growth rate</body>
        </notes>
      </parameter>
      <parameter id="mwd1de49e6_50db_455b_8149_7257c1327048" name="k_C1_death" value="0.003" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cancer death rate</body>
        </notes>
      </parameter>
      <parameter id="mweeaf48f4_f08c_4901_8e03_55a313cf8027" name="C_max" value="27000" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Aggregate tumor carrying capacity (Gompertzian denominator). Initialized = K_vasc here, then RE-DEFINED in fibroblast_module_enhanced to (C_cap0 + K_vasc + CAF stromal support) * collagen barrier.</body>
        </notes>
      </parameter>
      <parameter id="mw25cbde87_1bf3_4ae3_be84_90a7de242be9" name="k_C1_therapy" value="0" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Therapy-induced death rate</body>
        </notes>
      </parameter>
      <parameter id="mw7183b9f5_b44d_4781_aa23_0fc69e504cf6" name="initial_tumour_diameter" value="3.2" units="MWBUILTINPREFIX_centi_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pre-treatment tumor diameter</body>
        </notes>
      </parameter>
      <parameter id="mw12f0b572_e69d_4db5_928c_86dac794fb9f" name="K_initial" value="10300" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Initial tumor carrying capacity</body>
        </notes>
      </parameter>
      <parameter id="mwf52d74b0_4d28_4c24_ba5a_a65dbb27b4a6" name="k_vas_growth" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor vasculature growth rate</body>
        </notes>
