      <parameter id="mw984b18a0_30c9_45ab_aa9f_0407d77fc900" name="k_CXCL12_sec_cancer" value="5e-11" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 secretion rate by tumor cells</body>
        </notes>
      </parameter>
      <parameter id="mwd91bf171_5d01_45dd_94ab_368aa744476f" name="H_P1_apCAF" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for antigen-dependent apCAF Treg induction</body>
        </notes>
      </parameter>
      <parameter id="mw4536d83f_461d_465e_8d74_5f423c6d59f8" name="k_GVAX_clearance" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GVAX cell clearance rate from tumor</body>
        </notes>
      </parameter>
      <parameter id="mw168b671d_8412_4e78_8573_959faf4aa87e" name="V_ID_volume" value="0.0001" units="MWBUILTINUNIT_liter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of intradermal injection site (~0.1 mL)</body>
        </notes>
      </parameter>
      <parameter id="mw4406cfe4_862b_4638_a734_314b992f9696" name="k_GMCSF_prod" value="1e-08" units="MWDERIVEDUNIT_nanomolarity__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">GM-CSF production rate per GVAX cell per day</body>
        </notes>
