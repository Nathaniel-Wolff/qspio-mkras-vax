        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total activated PSC count (iCAF+myCAF+apCAF). Backward compatibility for test statistics.</body>
        </notes>
      </parameter>
      <parameter id="mw234c4221_a44b_4152_b9a3_0fb82680744f" name="k_TGFb_sec_myCAF" value="2e-10" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
