      <parameter id="mw880db9e3_099b_4426_a4de_4b2448a77ebc" name="k_IL6_sec_iCAF" value="2e-11" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 secretion rate by iCAFs</body>
        </notes>
