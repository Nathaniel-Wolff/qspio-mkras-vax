      <parameter id="mw0079c3d8_db0f_4556_9a24_cd1ce19fab8c" name="koff_CD47_SIRPa" value="0.3" units="MWDERIVEDUNIT_1__minute" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">koff of CD47-SIRPa binding </body>
        </notes>
      </parameter>
      <parameter id="mwe6a776e7_b44d_435c_9c07_9e560acf03c2" name="SIRPa_50" value="37" units="MWDERIVEDUNIT_molecule__micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">SIRPa occupancy for half-maximal CD47/SIRPa inhibition on phagocytosis of cancer cells by macrophages </body>
        </notes>
      </parameter>
      <parameter id="mwf1ee9ff9_ad6a_4293_a171_0f8bda2971f3" name="n_SIRPa" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for CD47/SIRPa inhibition on phagocytosis of cancer cells by macrophages </body>
        </notes>
      </parameter>
      <parameter id="mwcb844e4b_6253_4e35_a2bb_9e488fa95d7c" name="H_Mac_C" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for overall checkpoint inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mwcd0898ea_5f8a_4f39_a103_462861bd4547" name="H_PD1_M" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for PD1-mediated inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw0f6c2b5f_bf4f_468d_9c14_6629cd36f5ab" name="H_SIRPa" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for SIRPa-mediated inhibition on phagocytosis of cancer cell by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw09d6568d_f1c4_45d0_a3df_ee493f7a456b" name="C_CD47" value="400" units="MWDERIVEDUNIT_molecule__micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CD47 expression on cancer cells </body>
        </notes>
      </parameter>
      <parameter id="mw448bea48_5101_492f_aaf7_51bff32f8189" name="M_PD1_total" value="12500" units="MWBUILTINUNIT_molecule" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">PD-1 expression on macrophages </body>
        </notes>
      </parameter>
      <parameter id="mw7bebab62_e89f_434f_aac3_2ba1686a8c4a" name="M_SIRPa" value="100" units="MWDERIVEDUNIT_molecule__micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">SIRPa expression on macrophages </body>
        </notes>
      </parameter>
      <parameter id="mw36a88263_1736_4adf_af9e_a22ac34ffc99" name="A_Mcell" value="1385.4423602331" units="MWDERIVEDUNIT_micrometer___2" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Surface area of the macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw0d436ee7_9b14_4f3e_b26d_46a7db2de20f" name="IL10_50_phago" value="270" units="MWBUILTINPREFIX_pico_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal IL-10 level for phagocytosis by macrophage </body>
        </notes>
      </parameter>
      <parameter id="mw79b1549a_ddbd_445e_ab9d_c6a007269cd6" name="K_M1_phago" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Association coefficient for macrophage and cancer cell </body>
        </notes>
      </parameter>
      <parameter id="mw5efccc99_2273_4d67_93b4_2a0a9b5028e3" name="M_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of macrophages </body>
        </notes>
      </parameter>
      <parameter id="mwb9749fab_613f_4a3a_85c1_b7154ead3b92" name="H_IL10_APC" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill: IL-10 suppression of DC maturation (cDC1/cDC2)</body>
        </notes>
      </parameter>
      <parameter id="mwa709af10_2d06_45c7_a908_295fab0700fb" name="H_IL10_Treg" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill: IL-10 amplification of Treg-mediated CD8 exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw7a540062_4008_4602_a8aa_3eab250b427d" name="H_IL10_phago" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL10-mediated inhibition on phagocytosis </body>
        </notes>
      </parameter>
      <parameter id="mwec1c0069_e18d_4603_b1e1_5a3cbcd70044" name="H_IL12" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL12 </body>
        </notes>
      </parameter>
      <parameter id="mw3e9f0fe1_e6fd_4ef2_84d9_a43a69b807a1" name="H_IL6_M2" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL-6 promotion of M2 macrophage polarization</body>
        </notes>
      </parameter>
      <parameter id="mwdaae9381_6750_40e5_85d4_306a17279bb6" name="phi_M2_skew" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Averaged M2-polarizing milieu drive (TGFb/IL-10/IL-6); sets both the fraction of recruited monocytes differentiating directly to M2 and the M1-&gt;M2 polarization drive</body>
        </notes>
      </parameter>
      <parameter id="mw94d73d8e_0c06_4f19_ae21_57451e81c9b6" name="k_CAF_encounter" value="1000000" units="MWDERIVEDUNIT_cell__milliliter_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of encountering resident PSCs as tumor expands into pancreas</body>
        </notes>
      </parameter>
      <parameter id="mwa0b813d0_ab48_45a2_b129_f50e7fef48ec" name="k_CAF_const" value="2000000" units="MWDERIVEDUNIT_cell__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Constitutive PSC density in pancreatic tissue</body>
        </notes>
      </parameter>
      <parameter id="mw54617f13_5cc2_4e14_b608_94c4fee3011e" name="k_PSC_to_myCAF" value="0.2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;myCAF activation rate (TGFb-driven)</body>
        </notes>
      </parameter>
      <parameter id="mwf9202003_dfad_4337_a328_4fb677eee7b2" name="k_PSC_to_iCAF" value="0.2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;iCAF activation rate (IL-1-driven)</body>
        </notes>
      </parameter>
      <parameter id="mwebc3a886_8a0d_440b_8a1d_50f88ce47424" name="k_PSC_to_apCAF" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">qPSC-&gt;apCAF activation rate (constitutive low)</body>
        </notes>
      </parameter>
      <parameter id="mw42ac61cb_6d50_441d_9d4c_025e924fcad2" name="k_iCAF_to_myCAF" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF-&gt;myCAF interconversion (TGFb-driven)</body>
        </notes>
      </parameter>
      <parameter id="mw7eae0d4d_e9f0_449e_961d_871e8671d23e" name="k_myCAF_to_iCAF" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">myCAF-&gt;iCAF interconversion (IL-1-driven)</body>
        </notes>
      </parameter>
      <parameter id="mw3c22027e_15b7_4f64_a5ab_40593fc84f77" name="k_myCAF_prolif" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">myCAF proliferation rate</body>
        </notes>
      </parameter>
      <parameter id="mw0909b5ed_4969_4f6f_a6c9_d89835bd4f65" name="k_iCAF_prolif" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF proliferation rate</body>
        </notes>
      </parameter>
      <parameter id="mw8e26d46c_4c83_468d_9c86_f5350ae7043a" name="k_apCAF_prolif" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">apCAF proliferation rate (lower than iCAF/myCAF)</body>
        </notes>
      </parameter>
      <parameter id="mw080a94ce_6a94_43c7_a0b4_69cad074578a" name="f_stroma_max" value="2.43" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF:cancer ratio — total carrying-capacity budget partitioned across iCAF/myCAF/apCAF</body>
        </notes>
      </parameter>
      <parameter id="mw92b41cff_ad4a_4e02_9e9f_2fec2e90b928" name="f_apCAF_of_total" value="0.1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">apCAF share of the total CAF carrying capacity. Default 0.1 from Elyada 2019 Fig 5D (apCAFs ~10% of PDAC CAFs). Free parameter in the stick-breaking simplex parameterization (paired with f_iCAF_of_non_apCAF).</body>
        </notes>
      </parameter>
      <parameter id="mw93fe1b15_fd73_4365_a167_6eec8a6ee005" name="f_iCAF_of_non_apCAF" value="0.222" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">iCAF share of the non-apCAF CAF mass (stick-breaking second step). Default 0.222 from Elyada 2019 Fig 5D — myCAF 0.7 + iCAF 0.2 of total → iCAF/(iCAF+myCAF) = 0.2/0.9 = 0.222. Free parameter in the stick-breaking simplex parameterization (paired with f_apCAF_of_total).</body>
        </notes>
      </parameter>
      <parameter id="mwd4d2f4b2_8b93_478f_bc31_64cf172a19af" name="k_col_myCAF_sec" value="5e-08" units="MWDERIVEDUNIT_milligram__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen secretion rate by myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw7642b700_0967_4ad1_82b2_1542a4b86708" name="f_col_basal" value="0.15" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Basal fraction of collagen secretion (TGFb-independent)</body>
        </notes>
      </parameter>
      <parameter id="mw21d11ef7_96ec_4fe4_9185_d8594c0d0a5b" name="TGFb_50_CAF_act" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for CAF activation and interconversion</body>
        </notes>
      </parameter>
      <parameter id="mwbe324d9e_797b_4564_baa7_eef1d2fb2f2e" name="TGFb_50_col_sec" value="0.07" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">TGFb EC50 for collagen secretion</body>
        </notes>
      </parameter>
      <parameter id="mwb354d741_4ad8_4cb9_8f6c_d4e02c2655b6" name="k_col_deg" value="0.007" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Constitutive collagen degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mwbf478f8b_5dad_434e_9539_ebf9dd6b6a3e" name="k_MMP_M2" value="1e-08" units="MWDERIVEDUNIT_milliliter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">M2 macrophage MMP-mediated collagen degradation</body>
        </notes>
      </parameter>
      <parameter id="mw10ffbb3f_fa39_4608_b579_a88eed09292a" name="phi_cross_50" value="0.03" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction at 50% MMP-susceptibility (LOX-crosslinking shield)</body>
        </notes>
      </parameter>
      <parameter id="mwfc4aab79_9a61_46d9_bf8a_d5b848d4979e" name="f_nascent" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Fraction of collagen susceptible to M2 MMP degradation (non-crosslinked)</body>
        </notes>
      </parameter>
      <parameter id="mwe8007b43_370e_49ca_90ec_213f1afa1899" name="rho_collagen" value="0.103" units="MWDERIVEDUNIT_gram__milliliter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen packing density (material constant)</body>
        </notes>
      </parameter>
      <parameter id="mw1f49a0c2_43ac_4943_9d0e_4866900b5e20" name="phi_collagen" value="0.12" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction (0-1). Bare-volume normalized; primary input for all ECM Hill functions.</body>
        </notes>
      </parameter>
      <parameter id="mw603ce118_cdb5_4b71_9be4_686a9ec277db" name="k_qpsc_death" value="0.005" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of quiescent PSCs</body>
        </notes>
      </parameter>
      <parameter id="mw62ae4ca7_99d2_4096_af03_166a18ba2391" name="k_iCAF_death" value="0.05" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mwf0e6e0f9_256b_4d6f_98e0_3d11d3f830b7" name="k_myCAF_death" value="0.015" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of myCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw8b02b7d0_166d_4e8f_8aee_17fb8c887cae" name="k_apCAF_death" value="0.03" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Death rate of apCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw74dbc675_ef72_44f5_9328_cf2fa50ec6b8" name="d_pore_ref" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference pore size in normal pancreas (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mw16dfcb21_52b9_4555_a5b8_5b768389e4b7" name="phi_col_ref" value="0.046" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Collagen volume fraction in normal pancreas (reference)</body>
        </notes>
      </parameter>
      <parameter id="mw68873b36_163b_4a60_8b83_7e37f4ea87bb" name="d_crit_T" value="2.3" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for T cell migration arrest (Wolf 2013)</body>
        </notes>
      </parameter>
      <parameter id="mw012b6b64_1a88_4fe1_90d9_4f7d8b058797" name="d_crit_APC" value="2.1" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Critical pore diameter for APC migration arrest (podosome/MMP migration)</body>
        </notes>
      </parameter>
      <parameter id="mw6ae31a22_2cf5_4417_95c3_626aaaa38af6" name="n_pore" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for pore-size exclusion sharpness</body>
        </notes>
      </parameter>
      <parameter id="mwf0c5ef89_4c6d_4e08_9287_dce23722aa18" name="d_pore" value="3.5" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore size between collagen fibers (decreases with density)</body>
        </notes>
      </parameter>
      <parameter id="mwcbe9ae47_365f_49ec_b841_d0f163ccc779" name="H_pore_T" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based T cell exclusion. 1=fully excluded, 0=free migration.</body>
        </notes>
      </parameter>
      <parameter id="mw40135729_0d4e_49b3_bc60_d9b5b3d17c18" name="H_pore_APC" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pore-size-based APC exclusion. DCs more deformable than T cells.</body>
        </notes>
      </parameter>
      <parameter id="mwfbebfe4e_b3d4_4c2f_bc3e_6b963645847d" name="E_ref" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reference stiffness at phi_col_ref (~1 kPa, dimensionless)</body>
        </notes>
      </parameter>
      <parameter id="mw402e1a8e_fd53_4a2d_b964_9fa256990380" name="n_stiff" value="1.8" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Power law exponent for stiffness-collagen relationship</body>
        </notes>
      </parameter>
      <parameter id="mw576dc073_46d8_417c_b987_ca035ea6090a" name="E_50_Texh" value="4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwbd15d068_c12e_4bf6_8c74_2c86a679b63a" name="n_Texh" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwf6780e82_c5ec_426a_a49c_1372599fd605" name="E_50_fib" value="5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max stiffness for fibroblast mechanotransduction</body>
        </notes>
      </parameter>
      <parameter id="mwa9531595_3e9b_42c9_afb5_9c363ec7deb8" name="n_fib" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill coefficient for stiffness-mediated fibroblast activation</body>
        </notes>
      </parameter>
      <parameter id="mw0f344bba_58cd_485c_bdc2_bbd10f110f96" name="stiffness" value="1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tissue stiffness (kPa-scaled, dimensionless). Power law of collagen density.</body>
        </notes>
      </parameter>
      <parameter id="mwbe6e4d95_9078_405e_8bda_8485c714c819" name="H_stiff_Texh" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated T cell exhaustion (chronic mechanosensing, PD-L1)</body>
        </notes>
      </parameter>
      <parameter id="mw0c436822_fdab_457c_b536_3ed7c41e2c71" name="H_stiff_fib" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Stiffness-mediated fibroblast activation (YAP/TAZ mechanotransduction)</body>
        </notes>
      </parameter>
      <parameter id="mwd99fe512_c28f_4963_9938_b77d296e389a" name="phi_col_50_Kmax" value="2" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">phi_collagen for 50% carrying capacity reduction. &gt;1 = ECM barrier never reaches half-max, consistent with stroma-depletion worsening PDAC (Rhim 2014, Ozdemir 2014).</body>
        </notes>
      </parameter>
      <parameter id="mwa2c5798c_5758_40cb_86fb_7e0e67bbf807" name="phi_col_max" value="0.5" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Physical packing ceiling for collagen volume fraction (logistic secretion saturation). ~0.5 = peak fibrillar collagen packing in dense PDAC stroma (placeholder pending primary-source anchor).</body>
        </notes>
      </parameter>
      <parameter id="mwa73f6119_5219_46b6_a0e9_f62e23f01891" name="K_stiff_niche" value="100000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Max CAF population sustained by stiff ECM alone (mechanotransduction niche via YAP/TAZ). Allows fibrotic scar persistence post-therapy.</body>
        </notes>
      </parameter>
      <parameter id="mw0179b5ac_bb16_4e5d_bb27_aae0d84dd3dd" name="k_stroma_support" value="1" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Aggregate stromal contribution scale (global multiplier on subtype-weighted CAF sum in C_max). Constrained by Xu 2010 + Hwang 2008 orthotopic dose-response submodel targets.</body>
        </notes>
      </parameter>
      <parameter id="mw11635a97_494f_4ce3_b104_95e3d79bb2a5" name="k_stroma_myCAF" value="1.4" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-myCAF contribution to cancer C_max. myCAFs build PDAC desmoplasia (collagen/CXCL12/VEGF) — dominant structural CAF subtype (Elyada 2019; Dominguez 2020).</body>
        </notes>
      </parameter>
      <parameter id="mw0f627ef6_eed6_4c85_ad82_1e855c812a2a" name="k_stroma_iCAF" value="0.28" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-iCAF contribution to cancer C_max. iCAFs are inflammatory secretors (IL-6/CCL5), low αSMA, located distally from tumor — minimal structural carrying-capacity role (Elyada 2019, Öhlund 2017).</body>
        </notes>
      </parameter>
      <parameter id="mw08841adc_e5f6_4992_8e06_0f5acc2c6e47" name="k_stroma_apCAF" value="0.07" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-apCAF contribution to cancer C_max. apCAFs are rare (&lt;5% of CAFs) MHC-II+ tolerogenic antigen-presenters — predominantly immunomodulatory (induce Treg expansion in antigen-specific manner), not structural (Elyada 2019, Huang 2022 Cancer Cell).</body>
        </notes>
      </parameter>
      <parameter id="mw3de8aa57_7f6b_41c7_8906_293375b22f07" name="C_cap0" value="1700000000" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Baseline C-independent carrying-capacity floor (cells): parenchymal volume the lesion occupies pre-desmoplasia. UN-ANCHORED fitted structural handle (derivedFrom={}); value 1.7e9 is calibrated as the tumor_fold handle coupled with k_C1_growth~0.008, NOT a literature value. Candidate future submodel anchor: accessible parenchymal/lobular volume / vol_cell (queued in reconciliation_targets.csv) -- but GitHub #229 (V_T&lt;-&gt;C_max unification) would DERIVE and dissolve it. Default 0 recovers prior stroma+vascular-only C_max exactly.</body>
        </notes>
      </parameter>
      <parameter id="mw437de9e3_62ee_4f45_ae38_f44890cc07fb" name="vol_qPSCcell" value="1500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of quiescent PSC</body>
        </notes>
      </parameter>
      <parameter id="mw508d83fe_7394_4189_a743_451e07e10836" name="vol_iCAFcell" value="2000" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of iCAF</body>
        </notes>
      </parameter>
      <parameter id="mwfa8b5633_5ca0_4127_84bc_3295d03933fd" name="vol_myCAFcell" value="3500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of myCAF</body>
        </notes>
      </parameter>
      <parameter id="mwea2dbc94_f57c_4c2d_8973_16be5f4f450d" name="vol_apCAFcell" value="2500" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Volume of apCAF</body>
        </notes>
      </parameter>
      <parameter id="mwebc5081e_cf92_474d_81d9_405bee1fb2dd" name="k_CXCL12_sec_iCAF" value="1e-10" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 secretion rate by iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw2bd62dff_119a_4cdd_9db7_dd692dc418d1" name="k_CXCL12_deg" value="2" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CXCL12 degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw487b7e78_2fb4_4e87_9918_2ade41ed8444" name="CXCL12_50_Texcl" value="8" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for CXCL12-mediated T cell exclusion</body>
        </notes>
      </parameter>
      <parameter id="mw662e42cf_27a4_41c9_aaef_1eed01e74ea1" name="k_IL6_sec_iCAF" value="2e-11" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 secretion rate by iCAFs</body>
        </notes>
      </parameter>
      <parameter id="mw728f6255_0d85_43d2_80cb_230b0a494a3e" name="k_IL6_sec_C" value="5e-12" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 secretion rate by PDAC cancer cells</body>
        </notes>
      </parameter>
      <parameter id="mwc1c53cfc_459e_4afb_8207_aee0598ba295" name="k_IL6_sec_TAM" value="1e-11" units="MWDERIVEDUNIT_nanomolarity_liter__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 secretion rate by TAMs (M1+M2 pooled)</body>
        </notes>
      </parameter>
      <parameter id="mw2167562d_5ed9_446f_ad75_5545db16e2e9" name="k_IL6_deg" value="16" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">IL-6 degradation rate</body>
        </notes>
      </parameter>
      <parameter id="mw7a64b81b_4ff9_419c_a693_e5f4e47caac4" name="IL6_50_MDSC" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 enhancement of MDSC recruitment</body>
        </notes>
      </parameter>
      <parameter id="mw2e64aa72_ad9c_4529_8056_95926cda2bb9" name="IL6_50_M2" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 promotion of M2 polarization</body>
        </notes>
      </parameter>
      <parameter id="mwdc7b7dc7_f631_4d12_9ff2_01574a9b139c" name="IL6_50_iCAF" value="0.015" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for IL-6 autocrine feedback promoting iCAF phenotype</body>
        </notes>
      </parameter>
      <parameter id="mwf80dc34c_763e_46a0_98e9_02c0f26ee00f" name="f_IL6_iCAF" value="3" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Fold-enhancement of iCAF formation by IL-6 feedback</body>
        </notes>
      </parameter>
      <parameter id="mwd0a01b0f_762f_4410_beca_f1b55c7682c5" name="H_IL6_iCAF" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function for IL-6 autocrine feedback on iCAF phenotype</body>
        </notes>
      </parameter>
      <parameter id="mwcdc61f9a_c723_4ff4_9cdf_db14b43f1689" name="k_IL1_sec" value="1e-12" units="MWDERIVEDUNIT_nanomole__cell_day" constant="true">
        <notes>
