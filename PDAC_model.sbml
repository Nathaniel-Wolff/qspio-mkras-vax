      <parameter id="mwa4fe495d_d3ea_49fb_9782_a9d98178bf08" name="EC50_P1_mature" value="0.1" units="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">EC50 for antigen-dependent APC maturation. Lowered from 10 nM to 0.1 nM on 2026-04-21 (Fix 3): with the 10 nM value, V_ID.P1_GVAX (~0.009 nM steady state) produced a Hill factor of ~0.0009 in J_mature_ID, so GVAX-derived antigen was never a meaningful contributor to APC maturation — maturation proceeded almost entirely via the GMCSF + baseline APC terms. 0.1 nM is an estimated value in the nanomolar-affinity range typical of peptide/antigen-receptor interactions; not anchored to a specific primary source. Candidate for submodel-target extraction.</body>
        </notes>
      </parameter>
      <parameter id="mwbc8e3d10_83ed_4128_9d38_fcf4028b6a56" name="K_APC_ID" value="1000000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mw97a6c043_65bc_4502_b3d7_6b6b4938cb4b" name="k_APC_recruit0" value="100" units="MWDERIVEDUNIT_cell__day" constant="true"/>
      <parameter id="mw79d2132d_46b1_444a_9aff_a6aac25a0be5" name="k_mAPC_death_ID" value="0.7" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mw3d7fdfb3_b628_4de9_b7d0_a5f5b20f1ec1" name="y_Ag_per_cell" value="1e-09" units="MWDERIVEDUNIT_nanomole__cell" constant="true"/>
      <parameter id="mwce1dbc47_e4fb_451e_9a61_8f866d721252" name="k_P1_deg_ID" value="10" units="MWDERIVEDUNIT_1__day" constant="true"/>
      <parameter id="mw88e07887_2716_4138_a5a9_731158d26e95" name="K_APC_mig" value="100000" units="MWUSERUNIT_cell" constant="true"/>
      <parameter id="mw84581d88_ed8c_4376_9d3c_11aca7f18be4" name="k_cDC1_Ag_transfer" value="1e-07" units="MWDERIVEDUNIT_1__cell_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Antigen-transfer rate constant: migratory mcDC2 -&gt; resident cDC1 cross-licensing (Ferris 2022 PMID: 35648641; Mueller 2017 Eur J Immunol)</body>
        </notes>
      </parameter>
      <parameter id="mw27204872_ebdf_4fb8_a7cf_a77439ff2295" name="k_GVAX_present" value="14.4" units="MWDERIVEDUNIT_1__day__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Vaccine-antigen presentation-uptake rate into the shared endosomal pMHC pool; parallel to tumor k_up=14.4 (audit consensus #2, GVAX-&gt;H_P1 coupling); placeholder centered at k_up, SBI-varied, submodel anchor pending</body>
        </notes>
      </parameter>
      <parameter id="mw462a09ac_09d8_4970_b59b_11663946e1de" name="H_GMCSF_ID" value="0" units="dimensionless" constant="false"/>
      <parameter id="mw6c27a409_8610_4320_bfc9_77b7043c1f98" name="HMGB1_50_ID" value="10000000" units="MWDERIVEDUNIT_cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-max death FLUX (cell/day) for HMGB1 (DAMP)-mediated APC maturation at the GVAX injection depot; anchored to the depot operating death flux (~5e7 cell/day peak) so H_HMGB1_ID sits responsive. Literature-anchor route deferred (HMGB1_50_ID = EC50*k_deg*V_ID/q_release).</body>
        </notes>
      </parameter>
      <parameter id="mw746f4d4a_efba_44c6_91a9_f9c31bbca145" name="H_HMGB1_ID" value="0" units="dimensionless" constant="false"/>
      <parameter id="mw0ee82c66_3c3d_4ee0_9ace_194ad23b73e7" name="J_mature_ID" value="0" units="MWDERIVEDUNIT_cell__day" constant="false"/>
      <parameter id="mwa9c2b2d3_2776_4d61_8e33_3e1a3b9db2ed" name="f_epitope_spread" value="4.89897948556636" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Shared effective fold-broadening of tumor-specific CD4 and CD8 repertoires under saturating GVAX antigen (qualitatively anchored to Thomas 2004 PMID 15289501; geometric-mean initial value; estimated and requires reduced-model refit).</body>
        </notes>
      </parameter>
      <parameter id="mwf25b258f_e27e_493f_97f7_c4ada8d35bf7" name="H_P1_spread" value="0" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Vaccine-antigen Hill gating epitope-spreading clonal recruitment (Path A); 0 at diagnosis</body>
        </notes>
      </parameter>
      <parameter id="mw949d8b75_f875_47c6_875b_8415939bc1e8" name="k_Cy_clear" value="2.5" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cyclophosphamide clearance rate</body>
        </notes>
      </parameter>
      <parameter id="mwc7b3779a_024e_4068_b0dc_34faaee21065" name="k_Cy_Treg_deplete" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Maximum Treg depletion rate by cyclophosphamide</body>
        </notes>
      </parameter>
      <parameter id="mwba57cd13_c9b5_4a4d_b386_0e1029c2f6e5" name="Cy_50_Treg" value="50" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_gram" constant="true">
