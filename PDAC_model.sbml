    <listOfRules>
      <assignmentRule variable="mw17b20b77_5482_4e77_94bb_38244168aa38">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <plus/>
            <ci> mw7a789c66_a2b9_40e3_8baa_4b587f6c60bf </ci>
            <apply>
              <divide/>
              <apply>
                <plus/>
                <apply>
                  <times/>
