        </notes>
      </parameter>
      <parameter id="mw8398058a_1e0b_4427_a459_7306e2592b50" name="IL10_50_Treg" value="8" units="MWBUILTINPREFIX_pico_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal IL-10 level for amplifying Treg-mediated CD8 exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mwdccccdf8_bddd_407c_bcb2_7dc7d55711fb" name="IL12_50" value="15" units="MWBUILTINPREFIX_pico_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Half-maximal IL-12 level for M2 to M1 macrophage polarization </body>
        </notes>
      </parameter>
      <parameter id="mw6cd49b7c_4427_466e_883a_5396b27a8b76" name="k_IFNg_response" value="0.2" units="MWDERIVEDUNIT_1__picomolarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Linear slope of IFNg-driven M2 to M1 polarization in the sub-saturating regime (replaces IFNg_50 Hill)</body>
        </notes>
      </parameter>
      <parameter id="mw6ffc981b_69a9_4b54_88e7_b7c4d80d5309" name="k_M1_phago" value="0.33" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of M1 macrophage-mediated killing of cancer cell </body>
        </notes>
