      <species id="mwabfef809_52a2_4d23_b405_b3dbe3501e49" name="IL10" compartment="mw794bf877_74b4_444f_b55b_2f79cac410e1" initialConcentration="0" substanceUnits="MWDERIVEDUNIT_nanomolarity_milliliter" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false">
