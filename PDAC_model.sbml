    <listOfParameters>
      <parameter id="mwb9bd30b4_840e_4915_a94c_8ca057e04364" name="k_cell_clear" value="0.1" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of dead cell clearance from tumour compartment</body>
        </notes>
      </parameter>
      <parameter id="mw5a7ceba2_a70b_4490_b6be_313ec12702e1" name="cell" value="1" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">unit parameter for calculation</body>
        </notes>
      </parameter>
      <parameter id="mwb0b116bf_82f2_4544_8408_3fe439e4e1d9" name="day" value="1" units="MWBUILTINUNIT_day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">unit parameter for calculation</body>
        </notes>
      </parameter>
      <parameter id="mwf105836d_d837_42df_ba56_92f317d6c351" name="D_cell" value="17" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average diameter of cancer cell</body>
        </notes>
      </parameter>
      <parameter id="mwcca0d04a_91f6_4e45_af79_5d1b318c057d" name="vol_cell" value="2572.44078451444" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average volume of cancer cell</body>
        </notes>
      </parameter>
      <parameter id="mw46a2ef18_8709_4cba_b133_17fd82a8c6a3" name="vol_Tcell" value="175.015709799539" units="MWDERIVEDUNIT_micrometer___3__cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Average volume of T cells</body>
        </notes>
      </parameter>
      <parameter id="mw8c468967_31ac_48a1_b956_edd39fd3297e" name="Ve_T" value="0.37" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Intracellular fraction of the tumor</body>
        </notes>
      </parameter>
      <parameter id="mwe16986ce_9b7f_45e0_b2ed_cadf189eafd2" name="V_Tmin" value="1e-06" units="MWBUILTINPREFIX_milli_MWBUILTINUNIT_liter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Minimum tumor compartment volume (cancer-free baseline)</body>
        </notes>
      </parameter>
      <parameter id="mwecc04918_80ca_4b67_962b_508dfce9093b" name="C_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of cancer cells</body>
        </notes>
      </parameter>
      <parameter id="mw15a0a99c_ccc1_4a11_9aa3_678de38a050e" name="T_total" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of activated T cells in tumor</body>
        </notes>
      </parameter>
      <parameter id="mw9c60d10f_3aef_4d1b_b1cb_5a3a730a305d" name="T_total_LN" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of activated T cells in TDLNs</body>
        </notes>
      </parameter>
      <parameter id="mw529b0cc4_467d_4be5_ae4d_5ff796c95ac5" name="R_Tcell" value="1" units="MWDERIVEDUNIT_cell__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Rate of cancer cell death</body>
        </notes>
      </parameter>
      <parameter id="mw6e9a667c_0d1b_4eed_89f7_3e0019626a7c" name="Tregs_" value="0" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Total number of Tregs in tumor compartment (V_T.Treg)</body>
        </notes>
      </parameter>
      <parameter id="mw95148832_eddc_4dc7_b155_fd9bc8a63f02" name="H_APC_Treg" value="0.5" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of cDC2 for Treg activation (shared nCD4 pool, self-antigen)</body>
        </notes>
      </parameter>
      <parameter id="mwb1c731b0_1d0a_43a1_8935_8e76d70dd6ad" name="H_PD1_C1" value="0.9" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of PDL1 on chemotherapy-sensitive tumor cells for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw2ff9f66b_eecc_40eb_ba1d_e4983ace2bd2" name="H_PD1_APC" value="0.9" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of PDL1 on APC for T cell exhaustion</body>
        </notes>
      </parameter>
      <parameter id="mw596103c2_6310_42fc_99d4_6348fc7fc5cc" name="H_CD28_C1" value="0.1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of CD28 on tumor cells</body>
        </notes>
      </parameter>
      <parameter id="mw235890f3_a7e1_4ff8_86a3_f625fabbd064" name="H_CD28_APC" value="0.1" units="dimensionless" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Hill function of CD28 on APCs for T cell activation</body>
        </notes>
      </parameter>
      <parameter id="mw5e403eb2_b5ff_4381_881b_fe5cc85d3d93" name="k_C1_growth" value="0.008" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cancer growth rate</body>
        </notes>
      </parameter>
      <parameter id="mw4f381d5f_6972_4500_bdce_37462d328901" name="k_C1_death" value="0.003" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Cancer death rate</body>
        </notes>
      </parameter>
      <parameter id="mwb278a722_c787_420f_ac2b_ccb0e2c417b6" name="C_max" value="27000" units="MWUSERUNIT_cell" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Aggregate tumor carrying capacity (Gompertzian denominator). Initialized = K_vasc here, then RE-DEFINED in fibroblast_module_enhanced to (C_cap0 + K_vasc + CAF stromal support) * collagen barrier.</body>
        </notes>
      </parameter>
      <parameter id="mw081e2586_94b2_4952_8068_3d495b1c9f1a" name="k_C1_therapy" value="0" units="MWDERIVEDUNIT_1__day" constant="false">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Therapy-induced death rate</body>
        </notes>
      </parameter>
      <parameter id="mw44f053a4_4860_4965_8f6d_b2db96761ba5" name="initial_tumour_diameter" value="3.2" units="MWBUILTINPREFIX_centi_MWBUILTINUNIT_meter" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pre-treatment tumor diameter</body>
        </notes>
      </parameter>
      <parameter id="mw41f1ac26_d9e1_49c6_af83_ebdc1d0a2da3" name="K_initial" value="10300" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Initial tumor carrying capacity</body>
        </notes>
      </parameter>
      <parameter id="mw920b4333_15ca_4fd0_8022_e9841ab79a70" name="k_vas_growth" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor vasculature growth rate</body>
        </notes>
      </parameter>
      <parameter id="mw99ef3e00_0f53_4ad5_b90d_0f86d9ef0ba9" name="k_vas_decay" value="0.0001" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor vasculature inhibition rate</body>
        </notes>
      </parameter>
      <parameter id="mw769d3ed2_2b97_4ac7_b7d8_c2a2256f361e" name="vas_inhib_vol_scale" value="2.57e-06" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-cell tumor-volume scaling (cancer cell volume in mm^3 ~ 4/3*pi*(D_cell/2)^3*1e-9) for the Hahnfeldt 1999 V^(2/3) endogenous vascular-inhibition surface term (PMID 10519381).</body>
        </notes>
      </parameter>
      <parameter id="mw84ce154f_f350_4508_b93e_d66b46335b6f" name="k_vas_Csec" value="0.1" units="MWDERIVEDUNIT_picogram__cell__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor secretion rate</body>
        </notes>
      </parameter>
      <parameter id="mw0406bd91_0218_4702_88fe_b81a7befd67e" name="k_vas_deg" value="16.6" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Angiogenic factor degradation rate</body>
        </notes>
      </parameter>
