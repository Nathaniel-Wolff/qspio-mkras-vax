        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Pre-treatment tumor diameter</body>
        </notes>
      </parameter>
      <parameter id="mw4a9ccc9c_df6b_4b52_86fb_842ff8e0cdf2" name="K_initial" value="10300" units="MWUSERUNIT_cell" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Initial tumor carrying capacity</body>
        </notes>
      </parameter>
      <parameter id="mw14251bc3_c755_4cc3_8cf0_dc990ef28bb8" name="k_vas_growth" value="0.15" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor vasculature growth rate</body>
        </notes>
      </parameter>
      <parameter id="mw1e6754b2_6d50_4516_8e38_a8956b6ab78c" name="k_vas_decay" value="0.0001" units="MWDERIVEDUNIT_1__day" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Tumor vasculature inhibition rate</body>
        </notes>
      </parameter>
      <parameter id="mwf0028c5d_e281_4a68_8a24_ff748a68121c" name="vas_inhib_vol_scale" value="2.57e-06" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Per-cell tumor-volume scaling (cancer cell volume in mm^3 ~ 4/3*pi*(D_cell/2)^3*1e-9) for the Hahnfeldt 1999 V^(2/3) endogenous vascular-inhibition surface term (PMID 10519381).</body>
        </notes>
      </parameter>
