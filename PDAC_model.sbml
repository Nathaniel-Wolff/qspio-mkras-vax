            <apply>
              <times/>
              <ci> mwc3850272_2ef1_4b74_9541_2b2dcbef0229 </ci>
              <ci> mw6e5e0cc7_75c0_446a_8e15_bf4418c8d1c1 </ci>
              <ci> mwa536d324_54a4_4052_b74e_91db43f91cf2 </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
